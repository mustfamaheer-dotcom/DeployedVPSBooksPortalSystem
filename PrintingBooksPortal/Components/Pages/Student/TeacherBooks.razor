@page "/student/books/{tenantId:int}"
@using PrintingBooksPortal.Models
@attribute [Authorize(Roles = "Student")]
@rendermode InteractiveServer
@inject StudentService Students
@inject IServiceScopeFactory ScopeFactory
@inject NavigationManager Navigation

<div class="page-header">
    <div style="min-width: 0;">
        <h1 class="text-truncate">@teacherName's Books</h1>
        <p class="page-subtitle text-truncate">Books you have been granted access to</p>
    </div>
    <div class="page-header-actions flex-shrink-0">
        <a href="/student/dashboard" class="btn btn-outline-secondary d-flex align-items-center">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="me-sm-1"><polyline points="15 18 9 12 15 6"/></svg>
            <span class="d-none d-sm-inline">Back to Dashboard</span>
        </a>
        </div>
    </div>

    <div class="row mb-4 g-3">
        <div class="col-md-6 col-lg-4">
            <div class="input-group">
                <span class="input-group-text bg-white border-end-0 text-muted">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                </span>
                <input type="text" class="form-control border-start-0 ps-0" placeholder="Search books by title..." @bind="searchQuery" @bind:event="oninput" />
            </div>
        </div>
        <div class="col-md-6 col-lg-3">
            <select class="form-select" @bind="selectedBoardId">
                <option value="0">All Categories / Boards</option>
                @if (boards != null)
                {
                    @foreach (var b in boards)
                    {
                        <option value="@b.Id">@b.Name</option>
                    }
                }
            </select>
        </div>
    </div>

    @if (books == null)
    {
        <div class="text-center py-5 text-muted">Loading books...</div>
    }
    else if (!books.Any())
    {
        <div class="content-card py-5">
            <div class="empty-state">
                <div class="empty-icon">
                    <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="var(--gray-300)" stroke-width="1.5"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
                </div>
                <h5 class="mb-2">No Books Available</h5>
                <p class="text-muted">You haven't been granted access to any books from this teacher yet.</p>
            </div>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var book in FilteredBooks)
            {
                <div class="col-6 col-md-4 col-lg-3 col-xl-2">
                    <div class="card h-100 shadow-sm border-0" style="transition: transform 0.2s; min-height: 240px;">
                        <div class="card-body d-flex flex-column">
                            <div class="d-flex justify-content-between align-items-start mb-3">
                                <div class="badge bg-primary bg-opacity-10 text-primary">@book.Board?.Name</div>
                            </div>
                            
                            <h5 class="card-title fw-semibold mb-3">@book.Title</h5>
                            
                            @{
                                progresses.TryGetValue(book.Id, out var progress);
                                int percent = 0;
                                int last = 1;
                                int total = book.PageCount > 0 ? book.PageCount : 1;
                                if (progress != null)
                                {
                                    last = progress.LastPageRead;
                                    total = progress.TotalPages > 0 ? progress.TotalPages : total;
                                    percent = (int)Math.Clamp((double)last / total * 100, 0, 100);
                                }
                            }
                            
                            <div class="progress mb-2" style="height:4px;">
                                <div class="progress-bar bg-primary" style="width:@(percent)%;"></div>
                            </div>
                            
                            <p class="text-muted small mb-4 mt-auto">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="me-1" style="vertical-align:-2px"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="9" y1="21" x2="9" y2="9"/></svg>
                                Page @last / @total
                            </p>
                            
                            <button class="btn btn-primary w-100" @onclick="() => OpenViewer(book.Id)">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="me-2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                                @if (progress != null && progress.LastPageRead > 1)
                                {
                                    <text>Continue Reading (p.@last)</text>
                                }
                                else
                                {
                                    <text>Open & Read</text>
                                }
                            </button>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
@code {
    [Parameter]
    public int TenantId { get; set; }
    
    private string teacherName = "Teacher";
    private List<Book>? books;
    private List<EducationalBoard>? boards;
    private Dictionary<int, StudentReadingProgress> progresses = new();
    
    private string searchQuery = "";
    private int selectedBoardId = 0;
    
    private IEnumerable<Book> FilteredBooks => books?.Where(b => 
        (string.IsNullOrWhiteSpace(searchQuery) || b.Title.Contains(searchQuery, StringComparison.OrdinalIgnoreCase)) &&
        (selectedBoardId == 0 || b.BoardId == selectedBoardId)
    ) ?? Array.Empty<Book>();

    [CascadingParameter]
    private Task<AuthenticationState>? AuthState { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthState!;
        var userId = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        if (userId == null) return;
        
        using var scope = ScopeFactory.CreateScope();
        var db = scope.ServiceProvider.GetRequiredService<AppDbContext>();
        
        var user = await db.Users.FindAsync(userId);
        if (user == null) return;

        var tenant = await db.Tenants.FindAsync(TenantId);
        if (tenant != null) teacherName = tenant.Name;

        books = await Students.GetStudentBooksAsync(user.Id, TenantId);
        
        boards = await db.EducationalBoards.Where(b => b.TenantId == TenantId).ToListAsync();

        var pList = await db.StudentReadingProgresses
            .Where(p => p.StudentUserId == user.Id && p.TenantId == TenantId)
            .ToListAsync();
        progresses = pList.ToDictionary(p => p.BookId);
    }

    private void OpenViewer(int bookId)
    {
        // Open the viewer in a new tab so they don't lose their place in the dashboard
        Navigation.NavigateTo($"/student/viewer/{bookId}");
    }
}
