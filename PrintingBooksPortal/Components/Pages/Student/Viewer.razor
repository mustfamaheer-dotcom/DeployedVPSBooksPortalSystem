@page "/student/viewer/{bookId:int}"
@attribute [Authorize(Roles = "Student")]
@rendermode InteractiveServer
@inject IServiceScopeFactory ScopeFactory
@inject UserManager<ApplicationUser> UserManager
@inject NavigationManager Navigation
@inject IJSRuntime JS

<div class="student-viewer-layout">
    <div class="viewer-header d-flex flex-wrap justify-content-between align-items-center px-3 px-md-4 py-3 bg-white border-bottom shadow-sm gap-3">
        <div class="d-flex align-items-center">
            <button class="btn btn-light btn-sm me-3" @onclick="GoBack">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 18 9 12 15 6"/></svg>
            </button>
            <h5 class="mb-0 fw-semibold text-truncate" style="max-width: 300px;">@bookTitle</h5>
        </div>
        
        <div class="annotation-toolbar d-flex flex-wrap gap-2">
            <div class="btn-group shadow-sm">
                <button class="btn btn-outline-secondary" title="Highlight (Yellow)" onclick="studentAnnotations.setTool('highlight-yellow')">
                    <span style="color: #fbbf24;">●</span> Highlight
                </button>
                <button class="btn btn-outline-secondary" title="Highlight (Green)" onclick="studentAnnotations.setTool('highlight-green')">
                    <span style="color: #34d399;">●</span>
                </button>
                <button class="btn btn-outline-secondary" title="Highlight (Pink)" onclick="studentAnnotations.setTool('highlight-pink')">
                    <span style="color: #f472b6;">●</span>
                </button>
            </div>
            <button class="btn btn-outline-secondary shadow-sm" title="Pen Tool" onclick="studentAnnotations.setTool('pen')">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 19l7-7 3 3-7 7-3-3z"/><path d="M18 13l-1.5-7.5L2 2l3.5 14.5L13 18l5-5z"/><path d="M2 2l7.586 7.586"/><circle cx="11" cy="11" r="2"/></svg>
                Pen
            </button>
            <button class="btn btn-outline-secondary shadow-sm" title="Text Note" onclick="studentAnnotations.setTool('text')">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="4 7 4 4 20 4 20 7"/><line x1="9" y1="20" x2="15" y2="20"/><line x1="12" y1="4" x2="12" y2="20"/></svg>
                Text
            </button>
            <button class="btn btn-outline-secondary shadow-sm" title="Eraser" onclick="studentAnnotations.setTool('eraser')">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/></svg>
                Erase
            </button>
            
            <div class="vr mx-2"></div>
            
            <button class="btn btn-danger shadow-sm" onclick="studentAnnotations.clearAll()">
                Clear All
            </button>
        </div>
        
        <div class="d-flex align-items-center text-muted small">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="me-1"><path d="M21 2v6h-6"/><path d="M3 12a9 9 0 0 1 15-6.7L21 8"/><path d="M3 22v-6h6"/><path d="M21 12A9 9 0 0 1 6 18.7L3 16"/></svg>
            Saved Locally
        </div>
    </div>
    
    <div class="alert alert-info text-center rounded-0 mb-0 border-0 py-2 shadow-sm" style="font-size: 0.9rem;">
        <strong>Note:</strong> Annotations are saved privately in this browser. They are not uploaded to the server and will not appear if you use a different device.
    </div>

    <div class="viewer-container bg-light" style="height: calc(100vh - 120px); overflow: auto; position: relative;">
        @if (hasAccess)
        {
            <!-- PDF Viewer iframe or canvas -->
            <div id="pdf-container" style="position: relative; margin: 0 auto; width: fit-content; max-width: 100%; padding: 10px; overflow-x: auto;">
                <canvas id="pdf-canvas" class="shadow"></canvas>
                <!-- Annotation layer overlaid on top of the PDF canvas -->
                <canvas id="annotation-canvas" style="position: absolute; top: 20px; left: 20px; cursor: crosshair; z-index: 10;"></canvas>
            </div>
            
            <div class="viewer-controls position-fixed bottom-0 start-50 translate-middle-x mb-4 bg-white rounded-pill shadow px-4 py-2 d-flex align-items-center gap-3">
                <button class="btn btn-sm btn-light rounded-circle" onclick="studentAnnotations.prevPage()">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 18 9 12 15 6"/></svg>
                </button>
                <span class="fw-semibold">Page <span id="page-num">1</span> / <span id="page-count">--</span></span>
                <button class="btn btn-sm btn-light rounded-circle" onclick="studentAnnotations.nextPage()">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
                </button>
            </div>
        }
        else
        {
            <div class="d-flex h-100 justify-content-center align-items-center">
                <div class="text-center text-muted">
                    <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="mb-3"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                    <h4>Access Denied</h4>
                    <p>You do not have access to this book.</p>
                </div>
            </div>
        }
    </div>
</div>


@code {
    [Parameter]
    public int BookId { get; set; }
    
    private bool hasAccess = false;
    private string bookTitle = "";
    private int tenantId = 0;
    private string userId = "";

    [CascadingParameter]
    private Task<AuthenticationState>? AuthState { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthState!;
        var user = await UserManager.GetUserAsync(authState.User);
        if (user == null) return;
        
        userId = user.Id;
        
        using var scope = ScopeFactory.CreateScope();
        var db = scope.ServiceProvider.GetRequiredService<AppDbContext>();

        var access = await db.StudentBookAccesses
            .Include(a => a.Book)
            .FirstOrDefaultAsync(a => a.StudentUserId == user.Id && a.BookId == BookId && a.IsActive);
            
        if (access != null)
        {
            hasAccess = true;
            bookTitle = access.Book.Title;
            tenantId = access.TenantId;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && hasAccess)
        {
            // Initialize the viewer with the secure URL and the unique ID for localStorage
            var pdfUrl = $"/api/student/view/{BookId}";
            var storageKey = $"bp_annotations_{userId}_{BookId}";
            
            await JS.InvokeVoidAsync("studentAnnotations.init", pdfUrl, storageKey);
        }
    }

    private void GoBack()
    {
        if (tenantId > 0)
            Navigation.NavigateTo($"/student/books/{tenantId}");
        else
            Navigation.NavigateTo("/student/dashboard");
    }
}
