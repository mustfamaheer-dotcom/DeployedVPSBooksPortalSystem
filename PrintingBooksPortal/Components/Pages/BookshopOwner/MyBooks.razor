@page "/bookshop-owner/books"
@attribute [Authorize(Roles = "BookshopOwner")]
@rendermode InteractiveServer
@inject AppDbContext Db
@inject UserManager<ApplicationUser> UserManager
@inject NavigationManager Navigation

<div class="content-area">
    <div class="page-header d-flex justify-content-between align-items-center">
        <div>
            <h1>My Books</h1>
            <p class="page-subtitle">Books assigned to your shop for printing</p>
        </div>
        @if (tenantIdFilter.HasValue)
        {
            <button class="btn btn-outline-secondary btn-sm" @onclick="ClearFilter">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="me-1" style="vertical-align:-2px"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                Clear Filter
            </button>
        }
    </div>

    @if (books == null)
    {
        <div class="text-center py-5 text-muted">Loading books...</div>
    }
    else if (!books.Any())
    {
        <div class="content-card py-5">
            <div class="empty-state">
                <div class="empty-icon">
                    <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="var(--gray-300)" stroke-width="1.5"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
                </div>
                <h5 class="mb-2">No Books Found</h5>
                <p class="text-muted">No books have been assigned to your shop yet.</p>
                <a href="/bookshop-owner/teachers" class="btn btn-outline-primary mt-3">Connect with Teachers</a>
            </div>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var assignment in books)
            {
                var book = assignment.Book;
                <div class="col-md-4 col-lg-3">
                    <div class="card h-100 shadow-sm border-0">
                        <div class="card-body d-flex flex-column">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <div class="badge bg-primary bg-opacity-10 text-primary">@book.Board?.Name</div>
                            </div>
                            
                            <h5 class="card-title fw-semibold mb-1">@book.Title</h5>
                            <p class="text-muted small mb-3">by @book.Tenant?.Name</p>
                            
                            <div class="mt-auto">
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <span class="small text-muted"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="me-1" style="vertical-align:-2px"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="9" y1="21" x2="9" y2="9"/></svg>@book.PageCount pages</span>
                                    <span class="small text-muted"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="me-1" style="vertical-align:-2px"><polyline points="9 11 12 14 22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>@(printCounts.GetValueOrDefault(book.Id, 0)) printed</span>
                                </div>
                                <button class="btn btn-primary w-100" @onclick="() => PrintBook(book.Id)">
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="me-2"><polyline points="6 9 6 2 18 2 18 9"/><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><rect x="6" y="14" width="12" height="8"/></svg>
                                    Print Document
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    [SupplyParameterFromQuery(Name = "tenantId")]
    public int? tenantIdFilter { get; set; }

    private List<ShopBookAssignment>? books;
    private Dictionary<int, int> printCounts = new();

    [CascadingParameter]
    private Task<AuthenticationState>? AuthState { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthState!;
        var user = await UserManager.GetUserAsync(authState.User);
        if (user == null) return;
        
        var shopIds = new List<int>();
        if (user.ShopId.HasValue) shopIds.Add(user.ShopId.Value);
        
        var query = Db.ShopBookAssignments
            .Include(a => a.Book)
            .ThenInclude(b => b.Board)
            .Include(a => a.Book)
            .ThenInclude(b => b.Tenant)
            .Where(a => shopIds.Contains(a.ShopId) && a.IsActive);
            
        if (tenantIdFilter.HasValue)
        {
            query = query.Where(a => a.Book.TenantId == tenantIdFilter.Value);
        }
        
        books = await query.OrderBy(a => a.Book.Title).ToListAsync();
        
        var bookIds = books.Select(b => b.BookId).ToList();
        
        var counts = await Db.PrintLogs
            .Where(l => shopIds.Contains(l.ShopId) && bookIds.Contains(l.BookId))
            .GroupBy(l => l.BookId)
            .Select(g => new { BookId = g.Key, Total = g.Sum(l => l.Copies) })
            .ToListAsync();
            
        printCounts = counts.ToDictionary(c => c.BookId, c => c.Total);
    }
    
    private void ClearFilter()
    {
        Navigation.NavigateTo("/bookshop-owner/books");
    }

    private void PrintBook(int bookId)
    {
        Navigation.NavigateTo($"/shop/print/{bookId}"); // Delegate to existing print functionality
    }
}
