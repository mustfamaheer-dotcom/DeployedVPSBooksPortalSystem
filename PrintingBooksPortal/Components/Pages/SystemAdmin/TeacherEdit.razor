@page "/sa/teachers/{id:int}"
@attribute [Authorize(Roles = "SystemAdmin")]
@inject SystemAdminService Sa
@inject NavigationManager Navigation
@inject IJSRuntime js

<div class="content-area">
    <div class="page-header">
        <div>
            <h1>@(tenant?.name ?? "Teacher")</h1>
            <p class="page-subtitle">Tenant details, API keys and account management</p>
        </div>
        <div class="page-header-actions">
            <a href="/sa/teachers" class="btn btn-outline-secondary">Back to Teachers</a>
        </div>
    </div>

    @if (errorMessage != null)
    {
        <div class="alert alert-modern alert-danger">@errorMessage</div>
    }

    @if (tenant == null && errorMessage == null)
    {
        <div class="loading-placeholder">Loading...</div>
    }
    else
    {
        <div class="teacher-hero d-flex align-items-center gap-4 p-4 rounded mb-4 bg-white border">
            <div class="avatar-initials avatar-xl flex-shrink-0 d-flex align-items-center justify-content-center text-white rounded-circle shadow-sm" 
                 style="background: hsl(@HueFor(tenant?.name ?? "") 62% 46%); width: 80px; height: 80px; font-size: 2.5rem; font-weight: 600;">
                @Initials(tenant?.name)
            </div>
            <div class="teacher-hero-info">
                <div class="d-flex flex-wrap align-items-center gap-3 mb-2">
                    <h2 class="mb-0 fw-bold">@tenant?.name</h2>
                    <span class="plan-badge plan-@(PlanClass(tenant?.plan))">@(tenant?.plan ?? "Standard")</span>
                    <span class="status-badge @(tenant?.isActive == true ? "status-active" : "status-inactive") px-3 py-1">
                        <span class="status-dot"></span>
                        @(tenant?.isActive == true ? "Active" : "Inactive")
                    </span>
                </div>
                <div class="text-muted mb-2 fs-6">
                    <strong>@(tenant?.ownerName ?? "—")</strong> &middot; @(tenant?.contactEmail ?? "—") &middot; @(tenant?.phone ?? "—")
                </div>
                <div class="d-flex gap-3 mt-1">
                    <span class="usage-pill px-3 py-1"><span class="usage-dot usage-dot-primary"></span>Tenant #@(tenant?.id ?? 0)</span>
                    <span class="usage-pill px-3 py-1"><span class="usage-dot usage-dot-purple"></span>Member since @(tenant?.createdAt.ToEgyptLocal().ToString("dd MMM yyyy"))</span>
                </div>
            </div>
        </div>

        <div class="row g-4">
            <div class="col-lg-5">
                <div class="content-card">
                    <div class="card-header"><h5>Tenant Profile</h5></div>
                    <div class="card-body">
                        @if (savedMessage != null)
                        {
                            <div class="alert alert-modern alert-success">@savedMessage</div>
                        }
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label">Tenant / School Name</label>
                                <input class="form-control form-control-modern" @bind="profile.Name" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Owner Name</label>
                                <input class="form-control form-control-modern" @bind="profile.OwnerName" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Contact Email (login)</label>
                                <input class="form-control form-control-modern" @bind="profile.ContactEmail" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Phone</label>
                                <input class="form-control form-control-modern" @bind="profile.Phone" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Plan</label>
                                <select class="form-select form-control-modern" @bind="profile.Plan">
                                    <option value="">Standard</option>
                                    <option value="Pro">Pro</option>
                                    <option value="Enterprise">Enterprise</option>
                                </select>
                            </div>
                        </div>
                        <div class="d-flex gap-2 mt-3">
                            <button class="btn btn-primary" @onclick="SaveProfile" disabled="@(busy)">Save</button>
                            @if (tenant?.isActive == true)
                            {
                                <button class="btn btn-outline-warning" @onclick="() => ToggleActive(false)">Deactivate</button>
                            }
                            else
                            {
                                <button class="btn btn-outline-success" @onclick="() => ToggleActive(true)">Activate</button>
                            }
                        </div>
                    </div>
                </div>

                <div class="content-card mt-4">
                    <div class="card-header"><h5>Reset Password</h5></div>
                    <div class="card-body">
                        @if (pwMessage != null)
                        {
                            <div class="alert alert-modern alert-success">@pwMessage</div>
                        }
                        <div class="input-group mb-2">
                            <input type="password" class="form-control form-control-modern" placeholder="New password" @bind="newPassword" />
                            <button class="btn btn-outline-primary" @onclick="ResetPassword" disabled="@(busy)">Reset</button>
                        </div>
                    </div>
                </div>

                <div class="content-card mt-4">
                    <div class="card-header"><h5>Danger Zone</h5></div>
                    <div class="card-body">
                        @if (dangerMessage != null)
                        {
                            <div class="alert alert-modern alert-danger mb-2">@dangerMessage</div>
                        }
                        <button class="btn btn-outline-danger" @onclick="() => showDeleteConfirm = true">Delete tenant &amp; account</button>
                        <div class="small text-muted mt-2">Only works if the tenant has no shops, books or print logs.</div>
                    </div>
                </div>
            </div>

            <div class="col-lg-7">
                <div class="content-card">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <h5>API Keys</h5>
                        <button class="btn btn-sm btn-primary" @onclick="GenerateKey">Generate New Key</button>
                    </div>
                    <div class="card-body">
                        @if (generatedKey != null)
                        {
                            <div class="alert-modern alert alert-warning key-alert">
                                <div class="fw-semibold">Store this key now — it is shown only once:</div>
                                <div class="key-code-wrap">
                                    <code class="key-code">@generatedKey</code>
                                    <button class="btn btn-sm btn-outline-primary" @onclick="() => CopyGeneratedKey()">Copy</button>
                                </div>
                            </div>
                        }
                        @if (apiKeys == null)
                        {
                            <div class="loading-placeholder">Loading...</div>
                        }
                        else if (!apiKeys.Any())
                        {
                            <div class="empty-state"><p>No API keys. Print agents cannot connect until a key is created.</p></div>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="table table-modern table-hover align-middle mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th class="ps-3 border-0 rounded-start">Prefix</th>
                                            <th class="border-0">Bound To</th>
                                            <th class="border-0">Created</th>
                                            <th class="border-0">Status</th>
                                            <th class="text-end pe-3 border-0 rounded-end">Action</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var k in apiKeys)
                                        {
                                            <tr>
                                                <td class="ps-3"><code class="bg-light px-2 py-1 rounded text-dark border">@k.prefix…</code></td>
                                                <td>
                                                    @if (k.shopId.HasValue)
                                                    {
                                                        <span class="usage-pill bg-primary-subtle text-primary border-primary-subtle px-2 py-1"><span class="usage-dot usage-dot-primary"></span>@k.shopName</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-secondary text-white">Tenant-wide</span>
                                                    }
                                                </td>
                                                <td class="text-muted small">@k.createdAt.ToEgyptLocal().ToString("MMM dd, yyyy HH:mm")</td>
                                                <td>
                                                    <span class="status-badge @(k.isActive ? "status-active" : "status-inactive") px-2 py-1">
                                                        <span class="status-dot"></span>
                                                        @(k.isActive ? "Active" : "Revoked")
                                                    </span>
                                                </td>
                                                <td class="text-end pe-3">
                                                    @if (k.isActive)
                                                    {
                                                        <button class="btn btn-sm btn-outline-danger px-3 rounded-pill" @onclick="() => RevokeKey(k.Id)">Revoke</button>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                </div>

                <div class="content-card mt-4">
                    <div class="card-header"><h5>Shops</h5></div>
                    <div class="card-body p-0">
                        @if (shops == null)
                        {
                            <div class="loading-placeholder">Loading...</div>
                        }
                        else if (!shops.Any())
                        {
                            <div class="empty-state"><p>No shops yet</p></div>
                        }
                        else
                        {
                            <div class="list-group list-group-flush">
                                @foreach (var s in shops)
                                {
                                    <div class="list-group-item d-flex align-items-center justify-content-between">
                                        <div class="d-flex align-items-center gap-3">
                                            <div class="avatar-initials avatar-sm flex-shrink-0 d-flex align-items-center justify-content-center text-white rounded-circle shadow-sm" 
                                                 style="background: hsl(@HueFor(s.Name) 62% 46%); width: 40px; height: 40px; font-weight: bold;">
                                                @Initials(s.Name)
                                            </div>
                                            <span class="fw-semibold text-dark fs-6">@s.Name</span>
                                        </div>
                                        <div class="usage-pills">
                                            <span class="usage-pill"><span class="usage-dot usage-dot-primary"></span>@s.UsersCount users</span>
                                            <span class="usage-pill"><span class="usage-dot usage-dot-warning"></span>@s.Prints prints</span>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>

                <div class="content-card mt-4">
                    <div class="card-header"><h5>Recent Print Activity</h5></div>
                    <div class="card-body p-0">
                        @if (printLogs == null)
                        {
                            <div class="loading-placeholder">Loading...</div>
                        }
                        else if (!printLogs.Any())
                        {
                            <div class="empty-state"><p>No prints yet</p></div>
                        }
                        else
                        {
                            <div class="table-container">
                                <table class="table table-modern table-hover align-middle mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th class="ps-3 border-0 rounded-start">When</th>
                                            <th class="border-0">Shop</th>
                                            <th class="border-0">Book</th>
                                            <th class="text-end pe-3 border-0 rounded-end">Copies</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var l in printLogs)
                                        {
                                            <tr>
                                                <td class="ps-3 text-muted small">@l.PrintedAt.ToEgyptLocal().ToString("MMM dd, yyyy HH:mm")</td>
                                                <td class="fw-medium text-dark">@l.ShopName</td>
                                                <td class="text-muted">@l.BookTitle</td>
                                                <td class="text-end pe-3">
                                                    <span class="badge bg-primary rounded-pill px-3 py-2 fs-6">@l.Copies</span>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@if (showDeleteConfirm)
{
    <div class="modal-overlay show" @onclick="() => showDeleteConfirm = false">
        <div class="modal-container modal-sm" @onclick:stopPropagation>
            <div class="modal-header">
                <h5 class="modal-title">Delete Teacher</h5>
                <button type="button" class="modal-close" @onclick="() => showDeleteConfirm = false">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                </button>
            </div>
            <div class="modal-body">
                <p class="mb-1">Delete tenant <strong>@(tenant?.name ?? "?")</strong> and its owner account?</p>
                <p class="text-muted small mb-0">Only possible if the tenant has no shops, books or print logs.</p>
            </div>
            <div class="modal-actions">
                <button class="btn btn-outline-secondary" @onclick="() => showDeleteConfirm = false">Cancel</button>
                <button class="btn btn-danger" @onclick="DeleteTeacher" disabled="@(busy)">@(busy ? "Deleting..." : "Delete")</button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public int Id { get; set; }

    private SaTenantDetails? details;
    private SaTenantProfile? tenant => details?.tenant;
    private List<SaShopRow>? shops => details?.shops;
    private List<SaLogRow>? printLogs => details?.printLogs;
    private List<SaKeyRow>? apiKeys => details?.apiKeys;
    private string? errorMessage;
    private string? savedMessage;
    private string? pwMessage;
    private string? dangerMessage;
    private string? generatedKey;
    private string? newPassword;
    private bool busy;
    private bool showDeleteConfirm;

    protected override async Task OnInitializedAsync() => await Load();

    private async Task Load()
    {
        errorMessage = null;
        try
        {
            details = await Sa.GetTenantDetailsAsync(Id);
            if (details?.tenant == null)
            {
                errorMessage = "Teacher not found.";
                return;
            }
            RefreshProfile();
        }
        catch (Exception ex)
        {
            errorMessage = $"Could not load teacher: {ex.Message}";
        }
    }

    private void RefreshProfile()
    {
        profile = new ProfileModel
        {
            Name = details!.tenant.name,
            OwnerName = details.tenant.ownerName,
            ContactEmail = details.tenant.contactEmail,
            Phone = details.tenant.phone,
            Plan = details.tenant.plan
        };
    }

    private ProfileModel profile = new();
    private class ProfileModel
    {
        public string? Name { get; set; }
        public string? OwnerName { get; set; }
        public string? ContactEmail { get; set; }
        public string? Phone { get; set; }
        public string? Plan { get; set; }
    }

    private async Task SaveProfile()
    {
        busy = true;
        savedMessage = null;
        try
        {
            var (ok, error) = await Sa.UpdateTeacherAsync(Id, new UpdateTeacherData
            {
                Name = profile.Name,
                OwnerName = profile.OwnerName,
                ContactEmail = profile.ContactEmail,
                Phone = profile.Phone,
                Plan = profile.Plan
            });

            if (ok)
            {
                savedMessage = "Saved.";
                try { await js.InvokeVoidAsync("showToast", "Tenant profile updated.", "success"); } catch { }
                await Load();
            }
            else
            {
                errorMessage = error;
                try { await js.InvokeVoidAsync("showToast", error ?? "Save failed.", "error"); } catch { }
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Save failed: {ex.Message}";
            try { await js.InvokeVoidAsync("showToast", errorMessage, "error"); } catch { }
        }
        finally
        {
            busy = false;
        }
    }

    private async Task ToggleActive(bool activate)
    {
        try
        {
            var (_, error) = await Sa.SetTeacherActiveAsync(Id, activate);
            if (error != null)
            {
                errorMessage = error;
                try { await js.InvokeVoidAsync("showToast", error, "error"); } catch { }
            }
            else
            {
                savedMessage = activate ? "Tenant activated." : "Tenant deactivated.";
                try { await js.InvokeVoidAsync("showToast", savedMessage, "success"); } catch { }
                await Load();
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Action failed: {ex.Message}";
            try { await js.InvokeVoidAsync("showToast", errorMessage, "error"); } catch { }
        }
    }

    private async Task ResetPassword()
    {
        if (string.IsNullOrWhiteSpace(newPassword))
        {
            pwMessage = null;
            errorMessage = "Enter a new password first.";
            return;
        }
        busy = true;
        try
        {
            var (ok, error) = await Sa.ResetTeacherPasswordAsync(Id, newPassword);
            if (ok)
            {
                pwMessage = "Password updated.";
                newPassword = null;
                try { await js.InvokeVoidAsync("showToast", "Password updated successfully.", "success"); } catch { }
            }
            else
            {
                errorMessage = error;
                try { await js.InvokeVoidAsync("showToast", error ?? "Reset failed.", "error"); } catch { }
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Reset failed: {ex.Message}";
            try { await js.InvokeVoidAsync("showToast", errorMessage, "error"); } catch { }
        }
        finally
        {
            busy = false;
        }
    }

    private async Task GenerateKey()
    {
        busy = true;
        try
        {
            var generated = await Sa.GenerateKeyAsync(Id);
            if (generated == null)
            {
                errorMessage = "Tenant not found.";
                try { await js.InvokeVoidAsync("showToast", "Tenant not found.", "error"); } catch { }
            }
            else
            {
                generatedKey = generated.Value.apiKey;
                await RefreshKeys();
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Key generation failed: {ex.Message}";
            try { await js.InvokeVoidAsync("showToast", errorMessage, "error"); } catch { }
        }
        finally
        {
            busy = false;
        }
    }

    private async Task CopyGeneratedKey()
    {
        if (string.IsNullOrEmpty(generatedKey)) return;
        try
        {
            await js.InvokeVoidAsync("copyToClipboard", generatedKey);
            savedMessage = "API key copied to clipboard.";
        }
        catch
        {
            errorMessage = "Could not copy the key automatically — select and copy it manually.";
        }
    }

    private async Task RefreshKeys()
    {
        details ??= new SaTenantDetails();
        details!.apiKeys = await Sa.ListKeysAsync(Id);
    }

    private async Task RevokeKey(int keyId)
    {
        try
        {
            var (_, error) = await Sa.RevokeKeyAsync(Id, keyId);
            if (error != null)
                errorMessage = error;
            await RefreshKeys();
        }
        catch (Exception ex)
        {
            errorMessage = $"Revoke failed: {ex.Message}";
        }
    }

    private async Task DeleteTeacher()
    {
        showDeleteConfirm = false;
        busy = true;
        dangerMessage = null;
        try
        {
            var (ok, error) = await Sa.DeleteTeacherAsync(Id);
            if (ok)
            {
                Navigation.NavigateTo("/sa/teachers");
            }
            else
            {
                dangerMessage = error;
            }
        }
        catch (Exception ex)
        {
            dangerMessage = $"Delete failed: {ex.Message}";
        }
        finally
        {
            busy = false;
        }
    }

    private static string Initials(string? name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "?";
        var words = name.Split([' ', '-', '_'], StringSplitOptions.RemoveEmptyEntries);
        return words.Length > 1 ? $"{words[0][0]}{words[1][0]}".ToUpper() : words[0][..1].ToUpper();
    }

    private static int HueFor(string text)
    {
        var sum = 0;
        foreach (var c in text) sum += c;
        return sum % 360;
    }

    private static string PlanClass(string? plan) => (plan ?? "").ToLower() switch
    {
        "pro" => "plan-pro",
        "enterprise" => "plan-enterprise",
        _ => "plan-standard"
    };
}