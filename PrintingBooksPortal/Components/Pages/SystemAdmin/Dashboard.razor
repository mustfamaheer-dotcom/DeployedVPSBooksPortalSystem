@page "/sa/dashboard"
@attribute [Authorize(Roles = "SystemAdmin")]
@inject SystemAdminService Sa
@inject AppDbContext Db
@inject PrintingBooksPortal.Services.ISettingsService Settings

<div class="content-area dashboard-page">
    <div class="page-header">
        <div>
            <h1>Platform Dashboard</h1>
            <p class="page-subtitle">System-wide overview across all tenants</p>
        </div>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-md-2 col-6">
            <div class="stat-card stat-card-info" style="cursor: pointer;" @onclick='() => Navigation.NavigateTo("/sa/registrations")'>
                <div class="stat-card-bg"></div>
                <div class="stat-card-inner">
                    <div class="stat-icon text-info">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
                    </div>
                    <div class="stat-info">
                        <div class="stat-label">Requests</div>
                        <div class="stat-value">@pendingRegistrations</div>
                        <div class="stat-sub">Pending</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-2 col-6">
            <div class="stat-card stat-card-primary">
                <div class="stat-card-bg"></div>
                <div class="stat-card-inner">
                    <div class="stat-icon">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                    </div>
                    <div class="stat-info">
                        <div class="stat-label">Tenants</div>
                        <div class="stat-value">@(summary?.totals?.tenants ?? 0)</div>
                        <div class="stat-sub">@(summary?.totals?.activeTenants ?? 0) active</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-2 col-6">
            <div class="stat-card stat-card-success">
                <div class="stat-card-bg"></div>
                <div class="stat-card-inner">
                    <div class="stat-icon">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                    </div>
                    <div class="stat-info">
                        <div class="stat-label">Shops</div>
                        <div class="stat-value">@(summary?.totals?.shops ?? 0)</div>
                        <div class="stat-sub">across all tenants</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="stat-card stat-card-purple">
                <div class="stat-card-bg"></div>
                <div class="stat-card-inner">
                    <div class="stat-icon">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
                    </div>
                    <div class="stat-info">
                        <div class="stat-label">Books</div>
                        <div class="stat-value">@(summary?.totals?.books ?? 0)</div>
                        <div class="stat-sub">@(summary?.totals?.boards ?? 0) boards</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="stat-card stat-card-warning">
                <div class="stat-card-bg"></div>
                <div class="stat-card-inner">
                    <div class="stat-icon">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>
                    </div>
                    <div class="stat-info">
                        <div class="stat-label">Total Prints</div>
                        <div class="stat-value">@(summary?.totals?.prints ?? 0)</div>
                        <div class="stat-sub">all time</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-xl-8">
            <div class="content-card h-100">
                <div class="card-header d-flex align-items-center justify-content-between">
                    <h5>Tenant Snapshot</h5>
                    <a href="/sa/teachers" class="btn btn-sm btn-header-link">All Teachers</a>
                </div>
                <div class="card-body">
                    @if (perTenant == null)
                    {
                        <div class="loading-placeholder">Loading...</div>
                    }
                    else if (!perTenant.Any())
                    {
                        <div class="empty-state"><p>No tenants yet</p></div>
                    }
                    else
                    {
                        var maxPrints = perTenant.Max(t => t.prints);
                        var totalPrints = perTenant.Sum(t => t.prints);
                        <div class="row g-3">
                            @foreach (var t in perTenant.Take(6).OrderByDescending(t => t.prints))
                            {
                                var pct = maxPrints <= 0 ? 0 : (int)((double)t.prints / maxPrints * 100);
                                <div class="col-md-6 col-xl-4">
                                    <div class="tenant-mini-card">
                                        <div class="d-flex align-items-center gap-2 mb-1">
                                            <span class="avatar-initials avatar-sm" style="background: hsl(@HFor(t.tenantName) 62% 46%);">@Initials(t.tenantName)</span>
                                            <span class="fw-semibold tenant-name">@t.tenantName</span>
                                        </div>
                                        <div class="tenant-meta">
                                            <span class="usage-pill"><span class="usage-dot usage-dot-primary"></span>@t.shops shops</span>
                                            <span class="usage-pill"><span class="usage-dot usage-dot-warning"></span>@t.prints prints</span>
                                            @if (!t.isActive)
                                            {
                                                <span class="status-badge status-inactive"><span class="status-dot"></span>Inactive</span>
                                            }
                                            else
                                            {
                                                <span class="status-badge status-active"><span class="status-dot"></span>Active</span>
                                            }
                                        </div>
                                        <div class="progress-track mt-2"><div class="progress-fill" style="width: @(pct)%;"></div></div>
                                        <div class="small text-muted mt-1">
                                            @(totalPrints <= 0 ? "0" : (int)((double)t.prints / totalPrints * 100))% of platform prints
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
        
        <div class="col-xl-4">
            <div class="content-card h-100">
                <div class="card-header">
                    <h5>Platform Settings</h5>
                </div>
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center border-bottom pb-3 mb-3">
                        <div>
                            <div class="fw-semibold">Developer Tools</div>
                            <div class="small text-muted">Allow F12 / Inspect across the portal</div>
                        </div>
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" role="switch" style="width: 2.5em; height: 1.25em; cursor: pointer;"
                                   checked="@isDevToolsEnabled" 
                                   @onchange="ToggleDevTools" />
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private PlatformSummary? summary;
    private List<PlatformTenantRow>? perTenant => summary?.perTenant;
    private int pendingRegistrations;
    private bool isDevToolsEnabled = false;
    [Inject] private NavigationManager Navigation { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            summary = await Sa.GetPlatformSummaryAsync();
            pendingRegistrations = await Microsoft.EntityFrameworkCore.EntityFrameworkQueryableExtensions.CountAsync(Db.RegistrationRequests.Where(r => r.Status == RegistrationStatus.Pending));
            isDevToolsEnabled = await Settings.IsDeveloperToolsEnabledAsync();
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"SystemAdmin analytics load failed: {ex.Message}");
        }
    }

    private static string Initials(string name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "?";
        var words = name.Split([' ', '-', '_'], StringSplitOptions.RemoveEmptyEntries);
        return words.Length > 1 ? $"{words[0][0]}{words[1][0]}".ToUpper() : words[0][..1].ToUpper();
    }

    private static int HFor(string text)
    {
        var sum = 0;
        foreach (var c in text) sum += c;
        return sum % 360;
    }

    private async Task ToggleDevTools(ChangeEventArgs e)
    {
        isDevToolsEnabled = (bool)(e.Value ?? false);
        await Settings.SetDeveloperToolsEnabledAsync(isDevToolsEnabled);
    }
}