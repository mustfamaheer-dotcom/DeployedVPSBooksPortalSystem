@page "/shop/viewer/{BookId:int}"
@attribute [Authorize(Roles = "Shop")]
@rendermode InteractiveServer
@inject IServiceScopeFactory ScopeFactory
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthState
@inject NavigationManager Navigation
@inject IJSRuntime JS

@if (!authorized)
{
    <div class="viewer-unauthorized">
        <div class="unauthorized-card">
            <div class="unauthorized-icon">
                <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                </svg>
            </div>
            <h2>Access Restricted</h2>
            <p>You don't have permission to view this book.</p>
            <a href="/shop/mybooks" class="unauthorized-back">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
                Back to My Books
            </a>
        </div>
    </div>
}
else
{
    <div class="viewer-layout">
        <header class="viewer-header">
            <div class="viewer-header-inner">
                <div class="viewer-brand">
                    <a href="/shop/mybooks" class="viewer-back" title="Back to My Books">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
                    </a>
                    <div class="viewer-book-icon">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/>
                        </svg>
                    </div>
                    <div class="viewer-title-block">
                        <span class="viewer-eyebrow">@shopName</span>
                        <h1 class="viewer-title">@bookTitle</h1>
                    </div>
                </div>

                <div class="viewer-toolbar">
                    <div class="copies-control">
                        <label for="copiesInput">Copies</label>
                        <div class="copies-input-wrap">
                            <button type="button" class="copies-btn" id="copiesDec" aria-label="Decrease copies">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="5" y1="12" x2="19" y2="12"/></svg>
                            </button>
                            <input type="number" class="copies-input" id="copiesInput" value="1" min="1" max="100" />
                            <button type="button" class="copies-btn" id="copiesInc" aria-label="Increase copies">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                            </button>
                        </div>
                    </div>
                    <div class="settings-group" id="printSettingsGroup">
                        <button class="settings-toggle" id="settingsToggle" type="button" title="Print Settings">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
                        </button>
                        <div class="settings-panel" id="settingsPanel">
                            @* ─── Printer Section ─── *@
                            <div class="settings-section">
                                <div class="settings-label">Printer</div>
                                <div class="printer-select-wrap">
                                    <div class="printer-select-row">
                                        <select class="printer-select" id="printerSelect">
                                            <option value="">Select a printer…</option>
                                        </select>
                                        <button class="printer-refresh" id="printerRefresh" type="button" title="Refresh printer list">
                                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 4 23 10 17 10"/><path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"/></svg>
                                        </button>
                                    </div>
                                    <div class="printer-status" id="printerStatus">
                                        <span class="printer-status-dot" id="printerStatusDot"></span>
                                        <span id="printerStatusText">Detecting…</span>
                                    </div>
                                </div>
                            </div>

                            <div class="settings-divider"></div>

                            @* ─── Paper Size Section ─── *@
                            <div class="settings-section">
                                <div class="settings-label">Paper Size</div>
                                <div class="page-setup-row">
                                    <div class="page-setup-field" style="width:100%">
                                        <select class="page-setup-select" id="paperSizeSelect">
                                            <option value="Letter">Letter (8.5" × 11")</option>
                                            <option value="A4" selected>A4 (8.27" × 11.69")</option>
                                            <option value="Legal">Legal (8.5" × 14")</option>
                                            <option value="A3">A3 (11.69" × 16.54")</option>
                                            <option value="JISB4">JIS B4 (10.12" × 14.33")</option>
                                            <option value="JISB5">JIS B5 (7.17" × 10.12")</option>
                                            <option value="custom">More Paper Sizes…</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="custom-paper-grid" id="customPaperGrid" style="display:none">
                                    <div class="margin-field">
                                        <span class="margin-field-label">Width</span>
                                        <input type="number" class="margin-input" id="paperWidth" value="8.5" min="1" max="100" step="0.01" />
                                    </div>
                                    <div class="margin-field">
                                        <span class="margin-field-label">Height</span>
                                        <input type="number" class="margin-input" id="paperHeight" value="11" min="1" max="100" step="0.01" />
                                    </div>
                                    <div class="margin-field margin-unit-field">
                                        <span class="margin-field-label">Unit</span>
                                        <select class="margin-unit-select" id="paperUnit">
                                            <option value="in" selected>inches</option>
                                            <option value="mm">mm</option>
                                        </select>
                                    </div>
                                </div>
                            </div>

                            <div class="settings-divider"></div>

                            @* ─── Pages Section ─── *@
                            <div class="settings-section">
                                <div class="settings-label">Pages</div>
                                <div class="scaling-options" id="pageRangeOptions">
                                    <label class="scaling-radio">
                                        <input type="radio" name="pageRange" value="all" checked />
                                        <span>All pages</span>
                                    </label>
                                    <label class="scaling-radio">
                                        <input type="radio" name="pageRange" value="custom" />
                                        <span>Custom pages</span>
                                    </label>
                                </div>
                                <input type="text" class="page-range-input" id="pageRangeInput" placeholder="e.g. 1-5, 8, 11-13" disabled />
                                <div class="page-range-error" id="pageRangeError"></div>
                                <div class="pages-summary" id="pagesSummary"></div>
                            </div>

                            <div class="settings-divider"></div>

                            @* ─── Print Mode Section ─── *@
                            <div class="settings-section">
                                <div class="settings-label">Print Mode</div>
                                <div class="scaling-options" id="duplexOptions">
                                    <label class="scaling-radio">
                                        <input type="radio" name="duplex" value="off" checked />
                                        <span>Print One Sided</span>
                                    </label>
                                    <label class="scaling-radio">
                                        <input type="radio" name="duplex" value="long" />
                                        <span>Manually Print on Both Sides</span>
                                    </label>
                                </div>
                            </div>

                            <div class="settings-divider"></div>

                            @* ─── Scaling Section ─── *@
                            <div class="settings-section">
                                <div class="settings-label">Scaling</div>
                                <div class="scaling-options" id="scalingOptions">
                                    <label class="scaling-radio">
                                        <input type="radio" name="scaling" value="actual" checked />
                                        <span>Actual size</span>
                                    </label>
                                    <label class="scaling-radio">
                                        <input type="radio" name="scaling" value="fit" />
                                        <span>Fit to page</span>
                                    </label>
                                    <label class="scaling-radio">
                                        <input type="radio" name="scaling" value="shrink" />
                                        <span>Shrink oversized pages</span>
                                    </label>
                                    <label class="scaling-radio">
                                        <input type="radio" name="scaling" value="custom" />
                                        <span>Custom scale</span>
                                    </label>
                                    <div class="custom-scale-row" id="customScaleRow">
                                        <input type="range" id="customScaleSlider" min="10" max="200" value="100" step="5" />
                                        <input type="number" class="custom-scale-input" id="customScaleInput" value="100" min="10" max="200" />
                                        <span class="custom-scale-unit">%</span>
                                    </div>
                                </div>
                            </div>

                            <div class="settings-divider"></div>

                            @* ─── Margins Section ─── *@
                            <div class="settings-section">
                                <div class="settings-label">Margins</div>
                                <div class="margin-options-group">
                                    <div class="margin-options" id="marginOptions">
                                        <button class="margin-btn" data-margin="normal">Normal</button>
                                        <button class="margin-btn active" data-margin="narrow">Narrow</button>
                                        <button class="margin-btn" data-margin="moderate">Moderate</button>
                                        <button class="margin-btn" data-margin="wide">Wide</button>
                                        <button class="margin-btn" data-margin="mirrored">Mirrored</button>
                                        <button class="margin-btn" data-margin="office2003">Office 2003</button>
                                        <button class="margin-btn" data-margin="custom">Custom Margins…</button>
                                    </div>
                                </div>
                                <div class="custom-margin-grid" id="customMarginGrid">
                                    <div class="margin-field">
                                        <span class="margin-field-label">Top</span>
                                        <input type="number" class="margin-input" id="marginTop" value="12.7" min="0" max="200" step="0.1" />
                                    </div>
                                    <div class="margin-field">
                                        <span class="margin-field-label">Bottom</span>
                                        <input type="number" class="margin-input" id="marginBottom" value="12.7" min="0" max="200" step="0.1" />
                                    </div>
                                    <div class="margin-field">
                                        <span class="margin-field-label">Left</span>
                                        <input type="number" class="margin-input" id="marginLeft" value="12.7" min="0" max="200" step="0.1" />
                                    </div>
                                    <div class="margin-field">
                                        <span class="margin-field-label">Right</span>
                                        <input type="number" class="margin-input" id="marginRight" value="12.7" min="0" max="200" step="0.1" />
                                    </div>
                                    <div class="margin-field margin-unit-field">
                                        <span class="margin-field-label">Unit</span>
                                        <select class="margin-unit-select" id="marginUnitSelect">
                                            <option value="mm" selected>mm</option>
                                            <option value="in">inches</option>
                                        </select>
                                    </div>
                                </div>
                            </div>

                            <div class="settings-divider"></div>

                            @* ─── Display Section ─── *@
                            <div class="settings-section">
                                <div class="settings-label">Display</div>
                                <div class="zoom-control">
                                    <input type="range" id="zoomSlider" min="50" max="200" value="100" step="10" />
                                    <span class="zoom-value" id="zoomValue">100%</span>
                                </div>
                            </div>
                        </div>
                    </div>
                    <button class="print-btn" id="printBtn" onclick="handlePrint(event, @BookId)">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M6 9V2h12v7"/><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><path d="M6 14h12v8H6z"/>
                        </svg>
                        <span>Print</span>
                    </button>
                </div>
            </div>
        </header>

        <div class="pdf-container" id="pdfContainer">
            <div id="pdfViewer" class="pdf-canvas-container">
                <div class="pdf-loading" id="pdfLoading">
                    <div class="pdf-loading-card">
                        <div class="pdf-spinner"></div>
                        <span class="pdf-loading-text">Loading document...</span>
                        <div class="pdf-loading-bar"><span></span></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Print Result Modal -->
    <div class="modal fade print-modal" id="printResultModal" tabindex="-1" data-bs-backdrop="static" data-bs-keyboard="false">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-body print-modal-body" id="printModalBody">
                    <!-- IN-PROGRESS state -->
                    <div id="printModalStateProgress" class="print-modal-state">
                        <div class="print-modal-spinner"></div>
                        <h4 class="print-modal-title">Book is being printed now</h4>
                        <p class="print-modal-message">Sending your print job to the local printer agent…<br/>Please wait, this usually takes a few seconds.</p>
                        <div class="print-job-meta">
                            <span class="meta-pill"><span class="meta-dot meta-dot-progress"></span>Processing</span>
                        </div>
                    </div>

                    <!-- SUCCESS state -->
                    <div id="printModalStateSuccess" class="print-modal-state d-none">
                        <div class="print-modal-icon print-modal-icon-success">
                            <svg width="56" height="56" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/>
                            </svg>
                        </div>
                        <h4 class="print-modal-title">Print job sent successfully</h4>
                        <p class="print-modal-message">
                            The local printer agent has claimed your job and the book is now being printed on the configured printer.
                        </p>
                        <div class="print-job-meta">
                            <span class="meta-pill"><span class="meta-dot meta-dot-success"></span>Agent picked up</span>
                            <span class="meta-pill"><span class="meta-dot meta-dot-success"></span>Job removed from queue</span>
                        </div>
                        <button type="button" class="print-modal-close print-modal-close-primary" data-bs-dismiss="modal">Done</button>
                    </div>

                    <!-- ERROR state -->
                    <div id="printModalStateError" class="print-modal-state d-none">
                        <div class="print-modal-icon print-modal-icon-error">
                            <svg width="56" height="56" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/>
                            </svg>
                        </div>
                        <h4 class="print-modal-title">Print could not be started</h4>
                        <p class="print-modal-message">The server could not start the print job. See the details below.</p>
                        <div class="print-error-box">
                            <div class="print-error-row">
                                <span class="print-error-label">Reason</span>
                                <span class="print-error-value" id="printErrorReason">Unknown error</span>
                            </div>
                        </div>
                        <div class="print-help-box">
                            <div class="print-help-title">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
                                What to check
                            </div>
                            <ul class="print-help-list" id="printHelpList">
                                <li>Make sure the <strong>local printer agent</strong> is running on your computer.</li>
                                <li>Confirm you are signed in with the same account that opened the portal.</li>
                                <li>Check that the printer is online and has paper.</li>
                                <li>If the problem persists, contact your administrator.</li>
                            </ul>
                        </div>
                        <div class="print-modal-actions">
                            <button type="button" class="print-modal-close" data-bs-dismiss="modal">Close</button>
                            <button type="button" class="print-modal-close print-modal-close-primary" id="printRetryBtn">Try again</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public int BookId { get; set; }

    private string? bookTitle;
    private string? shopName;
    private bool authorized;

    protected override async Task OnInitializedAsync()
    {
        using var scope = ScopeFactory.CreateScope();
        var db = scope.ServiceProvider.GetRequiredService<AppDbContext>();

        var book = await db.Books.FindAsync(BookId);
        if (book == null)
        {
            Navigation.NavigateTo("/shop/mybooks");
            return;
        }

        bookTitle = book.Title;

        var authState = await AuthState.GetAuthenticationStateAsync();
        var user = await UserManager.GetUserAsync(authState.User);

        shopName = user?.FullName ?? "User";

        if (user?.ShopId == null)
        {
            authorized = false;
            return;
        }

        var hasAccess = await db.ShopBookAssignments
            .AnyAsync(a => a.ShopId == user.ShopId && a.BookId == BookId && a.IsActive);

        if (!hasAccess)
        {
            authorized = false;
            return;
        }

        authorized = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && authorized)
        {
            await JS.InvokeVoidAsync("initPdfViewer", BookId);
        }
    }
}
