@page "/admin/shops"
@attribute [Authorize(Roles = "Teacher,SystemAdmin")]
@rendermode InteractiveServer
@using Microsoft.AspNetCore.DataProtection
@inject AppDbContext Db
@inject UserManager<ApplicationUser> UserManager
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject ITenantContext TenantContext
@inject IDataProtectionProvider DataProtection
@inject UserManager<ApplicationUser> UserManager
@inject IHttpContextAccessor HttpContextAccessor

<div class="content-area">
    <div class="page-header">
        <div>
            <h1>Bookshops</h1>
            <p class="page-subtitle">Manage bookshops and their user accounts</p>
        </div>
        <div class="page-header-actions">
            <button class="btn btn-primary" @onclick="() => { editing = false; editModel = new(); error = null; showModal = true; }">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                Add Shop
            </button>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(message))
    {
        <div class="alert alert-modern alert-success">@message</div>
    }
    @if (!string.IsNullOrEmpty(error))
    {
        <div class="alert alert-modern alert-danger">@error</div>
    }

    @* Shop Modal *@
    <div class="modal-overlay @(showModal ? "show" : "")" @onclick="() => showModal = false">
        <div class="modal-container" @onclick:stopPropagation>
            <div class="modal-header">
                <h5 class="modal-title">@(editing ? "Edit Bookshop" : "Add New Bookshop")</h5>
                <button type="button" class="modal-close" @onclick="() => showModal = false">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                </button>
            </div>
            <div class="modal-body">
                <EditForm Model="@editModel" OnValidSubmit="@SaveShop">
                    <DataAnnotationsValidator />
                    <div class="mb-3">
                        <label class="form-label">Shop Name</label>
                        <InputText @bind-Value="editModel.Name" class="form-control form-control-modern" placeholder="Enter shop name" required />
                    </div>
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label">Phone</label>
                            <InputText @bind-Value="editModel.Phone" class="form-control form-control-modern" placeholder="Phone number" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Address</label>
                            <InputText @bind-Value="editModel.Address" class="form-control form-control-modern" placeholder="Shop address" />
                        </div>
                    </div>
                    @if (!editing)
                    {
                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label class="form-label">Login Email</label>
                                <InputText @bind-Value="editModel.Email" type="email" class="form-control form-control-modern" placeholder="Email for login" required />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Login Password</label>
                                <InputText @bind-Value="editModel.Password" type="password" class="form-control form-control-modern" placeholder="Password" required />
                            </div>
                        </div>
                        <div class="alert alert-info py-2 px-3 mb-3">
                            <small>A user account will be created for this shop with these credentials. The password will be stored (encrypted) so it can be viewed from the credentials button.</small>
                        </div>
                    }
                    else
                    {
                        <div class="mb-3">
                            <label class="form-label">New Login Password (optional)</label>
                            <InputText @bind-Value="editModel.Password" type="password" class="form-control form-control-modern" placeholder="Leave empty to keep the current password" />
                            <div class="form-hint">Changes the shop's login password. The new password will be stored (encrypted) for viewing later.</div>
                        </div>
                    }
                    <div class="modal-actions">
                        <button type="button" class="btn btn-outline-secondary" @onclick="() => showModal = false">Cancel</button>
                        <button type="submit" class="btn btn-primary">@(editing ? "Update Shop" : "Create Shop")</button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>

    @* Delete Confirmation *@
    <div class="modal-overlay @(showDeleteModal ? "show" : "")" @onclick="() => showDeleteModal = false">
        <div class="modal-container modal-sm" @onclick:stopPropagation>
            <div class="modal-body text-center py-4">
                <div class="delete-icon mb-3">
                    <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="var(--danger)" stroke-width="1.5"><path d="M3 6h18"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
                </div>
                <h5 class="mb-2">Delete Shop</h5>
                <p class="text-muted mb-3">This will also delete all associated user accounts. Are you sure?</p>
                <div class="modal-actions justify-content-center">
                    <button class="btn btn-outline-secondary" @onclick="() => showDeleteModal = false">Cancel</button>
                    <button class="btn btn-danger" @onclick="ConfirmDelete">Delete</button>
                </div>
            </div>
        </div>
    </div>

    @* Reset Stats Password Modal *@
    <div class="modal-overlay @(showResetModal ? "show" : "")" @onclick="() => showResetModal = false">
        <div class="modal-container modal-sm" @onclick:stopPropagation>
            <div class="modal-body text-center py-4">
                <div class="delete-icon mb-3">
                    <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="var(--warning)" stroke-width="1.5"><polyline points="23 4 23 10 17 10"/><path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"/></svg>
                </div>
                <h5 class="mb-2">Reset Statistics</h5>
                <p class="text-muted mb-3">This will delete all print logs for <strong>@resettingShopName</strong>. Enter <strong>your teacher password</strong> to confirm.</p>
                <div class="mb-3 text-start">
                    <input @bind="resetPassword" type="password" class="form-control form-control-modern" placeholder="Enter your password" />
                </div>
                @if (!string.IsNullOrEmpty(resetError))
                {
                    <div class="alert alert-danger py-1 px-2 mb-2"><small>@resetError</small></div>
                }
                <div class="modal-actions justify-content-center">
                    <button class="btn btn-outline-secondary" @onclick="CancelReset">Cancel</button>
                    <button class="btn btn-warning" @onclick="ConfirmReset">Reset</button>
                </div>
            </div>
        </div>
    </div>

    @* Change Password Modal *@
    <div class="modal-overlay @(showPassModal ? "show" : "")" @onclick="() => showPassModal = false">
        <div class="modal-container modal-sm" @onclick:stopPropagation>
            <div class="modal-body text-center py-4">
                <div class="delete-icon mb-3">
                    <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="var(--warning)" stroke-width="1.5"><path d="M21 2l-2 2m-7.61 7.61a5.5 5.5 0 1 1-7.778 7.778 5.5 5.5 0 0 1 7.777-7.777zm0 0L15.5 7.5m0 0l3 3L22 7l-3-3m-3.5 3.5L19 4"/></svg>
                </div>
                <h5 class="mb-2">Change Password</h5>
                <p class="text-muted mb-1">Login: <strong>@passLogin</strong></p>
                @if (string.IsNullOrEmpty(newPassword))
                {
                    <p class="text-muted mb-3">Generate a new random password for <strong>@passShopName</strong>.</p>
                    @if (!string.IsNullOrEmpty(passError))
                    {
                        <div class="alert alert-danger py-1 px-2 mb-2"><small>@passError</small></div>
                    }
                    <div class="modal-actions justify-content-center">
                        <button class="btn btn-outline-secondary" @onclick="() => showPassModal = false">Cancel</button>
                        <button class="btn btn-primary" @onclick="GeneratePassword">Generate &amp; Save</button>
                    </div>
                }
                else
                {
                    <div class="alert alert-success py-2 px-3 mb-3">
                        <small>New password for <strong>@passShopName</strong>:</small>
                        <div class="new-password-box">@newPassword</div>
                        <small class="text-muted">Shown once &mdash; copy it now. Stored passwords cannot be revealed later.</small>
                    </div>
                    <div class="modal-actions justify-content-center">
                        <button class="btn btn-primary" @onclick="() => { showPassModal = false; newPassword = null; }">Done</button>
                    </div>
                }
            </div>
        </div>
    </div>

    @* View Credentials Modal *@
    <div class="modal-overlay @(showCredModal ? "show" : "")" @onclick="() => showCredModal = false">
        <div class="modal-container modal-sm" @onclick:stopPropagation>
            <div class="modal-body text-center py-4">
                <div class="delete-icon mb-3">
                    <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="var(--primary)" stroke-width="1.5"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                </div>
                <h5 class="mb-1">Shop Credentials</h5>
                <p class="text-muted mb-3">Login details for <strong>@credShop?.Name</strong></p>

                <div class="text-start mb-3">
                    <label class="form-label">Login (Username)</label>
                    <div class="input-group">
                        <input readonly value="@credLogin" class="form-control form-control-modern cred-box" />
                        <button class="btn btn-outline-secondary btn-sm" @onclick="CopyLogin">
                            @(copied == "login" ? "Copied" : "Copy")
                        </button>
                    </div>
                </div>
                <div class="text-start mb-3">
                    <label class="form-label">Password</label>
                    @if (!string.IsNullOrEmpty(credPassword))
                    {
                        <div class="input-group">
                            <input readonly value="@credPassword" class="form-control form-control-modern cred-box" />
                            <button class="btn btn-outline-secondary btn-sm" @onclick="CopyPassword">
                                @(copied == "password" ? "Copied" : "Copy")
                            </button>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-warning py-2 px-3 mb-2">
                            <small>This password was not stored and cannot be recovered. Generate a new one below.</small>
                        </div>
                    }
                </div>
                <div class="modal-actions justify-content-center">
                    <button class="btn btn-outline-secondary" @onclick="() => showCredModal = false">Close</button>
                    <button class="btn btn-primary" @onclick="CredToChange">Change Password</button>
                </div>
            </div>
        </div>
    </div>

    <div class="content-card">
        <div class="card-body p-0">
            @if (shops == null)
            {
                <div class="loading-placeholder">Loading...</div>
            }
            else
            {
                <div class="table-container">
                    <table class="table table-modern">
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Login</th>
                                <th>Password</th>
                                <th>Address</th>
                                <th>Phone</th>
                                <th>Status</th>
                                <th>Created</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var shop in shops)
                            {
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="shop-icon">
                                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--success)" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
                                            </div>
                                            <strong>@shop.Name</strong>
                                        </div>
                                    </td>
                                    <td>
                                        @if (shopLogins.TryGetValue(shop.Id, out var login))
                                        {
                                            <span class="login-email">@login</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">No login</span>
                                        }
                                    </td>
                                    <td>
                                        @if (shopLogins.ContainsKey(shop.Id))
                                        {
                                            <span class="password-mask" title="Stored as a one-way hash — use the key button to set a new one">&bull;&bull;&bull;&bull;&bull;&bull;&bull;&bull;</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">&mdash;</span>
                                        }
                                    </td>
                                    <td class="text-muted">@shop.Address</td>
                                    <td>@shop.Phone</td>
                                    <td>
                                        <span class="status-badge @(shop.IsActive ? "status-active" : "status-inactive")">
                                            <span class="status-dot"></span>
                                            @(shop.IsActive ? "Active" : "Inactive")
                                        </span>
                                    </td>
                                    <td class="text-muted">@shop.CreatedAt.ToEgyptLocal().ToString("d")</td>
                                    <td class="text-end">
                                        <div class="action-btns">
                                            <button class="btn-icon btn-icon-edit" title="Edit" @onclick="() => { EditShop(shop); showModal = true; }">
                                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                                            </button>
                                            <button class="btn-icon btn-icon-toggle" title="@(shop.IsActive ? "Deactivate" : "Activate")" @onclick="() => ToggleShop(shop)">
                                                @if (shop.IsActive)
                                                {
                                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="4.93" y1="4.93" x2="19.07" y2="19.07"/></svg>
                                                }
                                                else
                                                {
                                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                                                }
                                            </button>
                                            <button class="btn-icon btn-icon-reset" title="Reset Stats" @onclick="() => { OpenReset(shop); }">
                                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="23 4 23 10 17 10"/><path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"/></svg>
                                            </button>
                                            <button class="btn-icon btn-icon-eye" title="View Login & Password" @onclick="() => OpenView(shop)">
                                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                                            </button>
                                            <button class="btn-icon btn-icon-key" title="Change Password" @onclick="() => OpenPassword(shop)">
                                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 2l-2 2m-7.61 7.61a5.5 5.5 0 1 1-7.778 7.778 5.5 5.5 0 0 1 7.777-7.777zm0 0L15.5 7.5m0 0l3 3L22 7l-3-3m-3.5 3.5L19 4"/></svg>
                                            </button>
                                            <button class="btn-icon btn-icon-receipt" title="Receipt PDF" @onclick="() => DownloadReceipt(shop.Id)">
                                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
                                            </button>
                                            <button class="btn-icon btn-icon-danger" title="Delete" @onclick="() => { deletingShop = shop; showDeleteModal = true; }">
                                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

@code {
    private List<Shop>? shops;
    private ShopEditModel editModel = new();
    private bool editing;
    private int editingId;
    private bool showModal;
    private bool showDeleteModal;
    private Shop? deletingShop;
    private string? message;
    private string? error;

    private bool showResetModal;
    private int resettingShopId;
    private string resettingShopName = "";
    private string resetPassword = "";
    private string? resetError;

    private bool showPassModal;
    private int passShopId;
    private string passShopName = "";
    private string? passLogin;
    private string? newPassword;
    private string? passError;
    private Dictionary<int, string> shopLogins = new();

    private bool showCredModal;
    private Shop? credShop;
    private string? credLogin;
    private string? credPassword;
    private string copied = "";

    private IDataProtector? _protector;

    protected override async Task OnInitializedAsync()
    {
        _protector = DataProtection.CreateProtector("Shop.Credentials");
        await LoadShops();
    }

    private async Task LoadShops()
    {
        shops = await Db.Shops.OrderBy(s => s.Name).ToListAsync<Shop>();
        var users = await UserManager.Users.Where(u => u.ShopId != null)
            .Select(u => new { u.ShopId, u.Email, u.UserName })
            .ToListAsync();
        shopLogins = users
            .GroupBy(u => u.ShopId!.Value)
            .ToDictionary(g => g.Key, g => g.First().Email ?? g.First().UserName ?? "");
    }

    private void EditShop(Shop shop)
    {
        editing = true;
        editingId = shop.Id;
        editModel.Name = shop.Name;
        editModel.Address = shop.Address;
        editModel.Phone = shop.Phone;
        editModel.Password = null;
        error = null;
    }

    private void OpenView(Shop shop)
    {
        credShop = shop;
        credLogin = shopLogins.TryGetValue(shop.Id, out var login) ? login : "—";
        credPassword = null;
        if (!string.IsNullOrEmpty(shop.StoredPassword) && _protector != null)
        {
            try
            {
                credPassword = _protector.Unprotect(shop.StoredPassword);
            }
            catch
            {
                credPassword = null;
            }
        }
        copied = "";
        showCredModal = true;
    }

    private async Task CopyLogin()
    {
        if (!string.IsNullOrEmpty(credLogin))
        {
            await JS.InvokeVoidAsync("copyToClipboard", credLogin);
            copied = "login";
        }
    }

    private async Task CopyPassword()
    {
        if (!string.IsNullOrEmpty(credPassword))
        {
            await JS.InvokeVoidAsync("copyToClipboard", credPassword);
            copied = "password";
        }
    }

    private async Task CredToChange()
    {
        showCredModal = false;
        if (credShop != null)
            await OpenPassword(credShop);
    }

    private async Task SaveShop()
    {
        error = null;

        if (editing)
        {
            var shop = await Db.Shops.FindAsync(editingId);
            if (shop != null)
            {
                shop.Name = editModel.Name;
                shop.Address = editModel.Address;
                shop.Phone = editModel.Phone;

                if (!string.IsNullOrWhiteSpace(editModel.Password))
                {
                    var user = await UserManager.Users.FirstOrDefaultAsync(u => u.ShopId == shop.Id);
                    if (user != null)
                    {
                        var token = await UserManager.GeneratePasswordResetTokenAsync(user);
                        var result = await UserManager.ResetPasswordAsync(user, token, editModel.Password);
                        if (result.Succeeded)
                        {
                            shop.StoredPassword = _protector?.Protect(editModel.Password);
                            message = "Shop updated and password changed.";
                        }
                        else
                        {
                            error = $"Failed to change password: {string.Join(", ", result.Errors.Select(e => e.Description))}";
                            return;
                        }
                    }
                }
                else
                {
                    message = "Shop updated successfully.";
                }
            }
        }
        else
        {
            if (string.IsNullOrWhiteSpace(editModel.Email) || string.IsNullOrWhiteSpace(editModel.Password))
            {
                error = "Email and password are required for new shops.";
                return;
            }

            var existingUser = await UserManager.FindByEmailAsync(editModel.Email);
            if (existingUser != null)
            {
                error = "A user with this email already exists.";
                return;
            }

            var shop = new Shop
            {
                Name = editModel.Name,
                Address = editModel.Address,
                Phone = editModel.Phone,
                StoredPassword = _protector?.Protect(editModel.Password)
            };
            Db.Shops.Add(shop);
            await Db.SaveChangesAsync();

            var user = new ApplicationUser
            {
                UserName = editModel.Email,
                Email = editModel.Email,
                FullName = editModel.Name,
                ShopId = shop.Id,
                TenantId = TenantContext.TenantId,
                EmailConfirmed = true
            };

            var result = await UserManager.CreateAsync(user, editModel.Password);
            if (result.Succeeded)
            {
                await UserManager.AddToRoleAsync(user, "Shop");
                message = $"Shop '{shop.Name}' created with login: {editModel.Email} and password: {editModel.Password} (store it securely — it cannot be shown again later).";
            }
            else
            {
                Db.Shops.Remove(shop);
                await Db.SaveChangesAsync();
                error = $"Failed to create user: {string.Join(", ", result.Errors.Select(e => e.Description))}";
                return;
            }
        }

        await Db.SaveChangesAsync();
        await LoadShops();
        showModal = false;
        editModel = new();
        editing = false;
    }

    private async Task ToggleShop(Shop shop)
    {
        shop.IsActive = !shop.IsActive;
        await Db.SaveChangesAsync();
        await LoadShops();
    }

    private async Task ConfirmDelete()
    {
        if (deletingShop == null) return;
        var users = await UserManager.Users.Where(u => u.ShopId == deletingShop.Id).ToListAsync();
        foreach (var user in users)
            await UserManager.DeleteAsync(user);

        Db.Shops.Remove(deletingShop);
        await Db.SaveChangesAsync();
        await LoadShops();
        message = "Shop deleted.";
        showDeleteModal = false;
        deletingShop = null;
    }

    private void OpenReset(Shop shop)
    {
        resettingShopId = shop.Id;
        resettingShopName = shop.Name;
        resetPassword = "";
        resetError = null;
        showResetModal = true;
    }

    private void CancelReset()
    {
        showResetModal = false;
        resetError = null;
        resetPassword = "";
    }

    private async Task ConfirmReset()
    {
        if (string.IsNullOrWhiteSpace(resetPassword))
        {
            resetError = "Password is required.";
            return;
        }

        try
        {
            // Get current user
            var user = await UserManager.GetUserAsync(HttpContextAccessor?.HttpContext?.User);
            if (user == null)
            {
                resetError = "User not found.";
                return;
            }

            // Verify password
            var passwordValid = await UserManager.CheckPasswordAsync(user, resetPassword);
            if (!passwordValid)
            {
                resetError = "Wrong password. Stats were NOT reset.";
                return;
            }

            // Verify shop belongs to user's tenant
            var shop = await Db.Shops.FindAsync(resettingShopId);
            if (shop == null)
            {
                resetError = "Shop not found.";
                return;
            }

            if (user.TenantId.HasValue && shop.TenantId != user.TenantId.Value)
            {
                resetError = "Access denied.";
                return;
            }

            // Delete print logs
            var logs = await Db.PrintLogs.Where(l => l.ShopId == resettingShopId).ToListAsync();
            Db.PrintLogs.RemoveRange(logs);
            await Db.SaveChangesAsync();

            message = $"Statistics reset for '{shop.Name}' ({logs.Count} log entries removed).";
            showResetModal = false;
            resetPassword = "";
        }
        catch (Exception ex)
        {
            resetError = "Error: " + ex.Message;
        }
    }

    private async Task DownloadReceipt(int shopId)
    {
        await JS.InvokeVoidAsync("open", $"/api/admin/shop-receipt/{shopId}", "_blank");
    }

    private async Task OpenPassword(Shop shop)
    {
        passShopId = shop.Id;
        passShopName = shop.Name;
        passLogin = shopLogins.TryGetValue(shop.Id, out var login) ? login : "—";
        newPassword = null;
        passError = null;
        showPassModal = true;
    }

    private async Task GeneratePassword()
    {
        passError = null;
        var user = await UserManager.Users.FirstOrDefaultAsync(u => u.ShopId == passShopId);
        if (user == null)
        {
            passError = "No login account found for this shop.";
            return;
        }

        var token = await UserManager.GeneratePasswordResetTokenAsync(user);
        var candidate = CreateNewPassword();
        var result = await UserManager.ResetPasswordAsync(user, token, candidate);
        if (result.Succeeded)
        {
            newPassword = candidate;
            var shop = await Db.Shops.FindAsync(passShopId);
            if (shop != null)
            {
                shop.StoredPassword = _protector?.Protect(candidate);
                await Db.SaveChangesAsync();
            }
            message = $"Password changed for '{passShopName}'.";
        }
        else
        {
            passError = $"Failed: {string.Join(", ", result.Errors.Select(e => e.Description))}";
        }
    }

    private static string CreateNewPassword()
    {
        const string upper = "ABCDEFGHJKLMNPQRSTUVWXYZ";
        const string lower = "abcdefghijkmnpqrstuvwxyz";
        const string digits = "23456789";
        const string special = "!@#$%&*";
        var rnd = Random.Shared;
        var chars = new[]
        {
            upper[rnd.Next(upper.Length)],
            lower[rnd.Next(lower.Length)],
            digits[rnd.Next(digits.Length)],
            special[rnd.Next(special.Length)],
            upper[rnd.Next(upper.Length)],
            lower[rnd.Next(lower.Length)],
            digits[rnd.Next(digits.Length)],
            special[rnd.Next(special.Length)],
            lower[rnd.Next(lower.Length)],
            digits[rnd.Next(digits.Length)],
            lower[rnd.Next(lower.Length)],
            digits[rnd.Next(digits.Length)]
        };
        return new string(chars.OrderBy(_ => rnd.Next()).ToArray());
    }

