@page "/admin/settings"
@attribute [Authorize(Roles = "Teacher,SystemAdmin")]
@rendermode InteractiveServer
@inject ISettingsService SettingsService
@inject UserManager<ApplicationUser> UserManager
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject AuthenticationStateProvider AuthStateProvider

<div class="content-area">
    <div class="page-header">
        <div>
            <h1>System Settings</h1>
            <p class="page-subtitle">Configure portal-wide behavior</p>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(message))
    {
        <div class="alert alert-modern alert-success">@message</div>
    }
    @if (!string.IsNullOrEmpty(error))
    {
        <div class="alert alert-modern alert-danger">@error</div>
    }

    <div class="settings-grid">
        <!-- Watermark Toggle Card -->
        <div class="setting-card">
            <div class="setting-card-header">
                <div class="setting-icon setting-icon-@(watermarkEnabled ? "on" : "off")">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12 2C9 6 7 9 7 12a5 5 0 0 0 10 0c0-3-2-6-5-10z"/>
                    </svg>
                </div>
                <div>
                    <h3 class="setting-title">PDF Watermark</h3>
                    <p class="setting-subtitle">Stamp shop + user identity on every page when admin or shop users view or print a book.</p>
                </div>
            </div>
            <div class="setting-card-body">
                <label class="toggle-row">
                    <div class="toggle-info">
                        <span class="toggle-label">@((watermarkEnabled) ? "Watermark is ACTIVE" : "Watermark is DISABLED")</span>
                        <span class="toggle-hint">@((watermarkEnabled) ? "Every viewed or printed PDF will be stamped." : "PDFs are served without any stamp.")</span>
                    </div>
                    <div class="toggle-switch @(watermarkEnabled ? "is-on" : "")">
                        <input type="checkbox" checked="@watermarkEnabled" @onchange="OnWatermarkChanged" />
                        <span class="toggle-slider"></span>
                    </div>
                </label>
            </div>
        </div>

        <!-- Watermark Text Card -->
        <div class="setting-card">
            <div class="setting-card-header">
                <div class="setting-icon setting-icon-on">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
                    </svg>
                </div>
                <div>
                    <h3 class="setting-title">Watermark Text</h3>
                    <p class="setting-subtitle">Customize the text stamped on each page. Use placeholders to insert dynamic values.</p>
                </div>
            </div>
            <div class="setting-card-body">
                <div class="watermark-placeholders">
                    <span class="placeholder-label">Available placeholders:</span>
                    <code class="placeholder-tag">{shopName}</code>
                    <code class="placeholder-tag">{userName}</code>
                    <code class="placeholder-tag">{date}</code>
                    <code class="placeholder-tag">{timestamp}</code>
                </div>

                <div class="watermark-editor">
                    <textarea class="watermark-textarea" @bind="watermarkText" rows="5" spellcheck="false"></textarea>
                </div>

                <div class="watermark-preview">
                    <span class="preview-label">Preview:</span>
                    <div class="preview-box">
                        @foreach (var line in GetPreviewLines())
                        {
                            <div class="preview-line">@line</div>
                        }
                    </div>
                </div>

                <div class="watermark-actions">
                    <button class="btn btn-sm btn-outline-secondary" @onclick="RestoreDefaultWatermark">Restore Default</button>
                    <button class="btn btn-sm btn-primary" @onclick="SaveWatermarkText" disabled="@(savingText || watermarkText == originalWatermarkText)">
                        @if (savingText)
                        {
                            <span class="loading-spinner me-1"></span>
                        }
                        @(savingText ? "Saving..." : "Save Text")
                    </button>
                </div>

                @if (!string.IsNullOrEmpty(textMessage))
                {
                    <div class="alert alert-modern alert-success mt-2 mb-0">@textMessage</div>
                }
                @if (!string.IsNullOrEmpty(textError))
                {
                    <div class="alert alert-modern alert-danger mt-2 mb-0">@textError</div>
                }
            </div>
        </div>
    </div>
</div>

<!-- Change Password Section -->
<div class="settings-grid mt-4">
    <div class="setting-card">
        <div class="setting-card-header">
            <div class="setting-icon setting-icon-on">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                </svg>
            </div>
            <div>
                <h3 class="setting-title">Change Password</h3>
                <p class="setting-subtitle">Update your login password. You will need to enter your current password.</p>
            </div>
        </div>
        <div class="setting-card-body">
            @if (!string.IsNullOrEmpty(pwMessage))
            {
                <div class="alert alert-modern alert-success">@pwMessage</div>
            }
            @if (!string.IsNullOrEmpty(pwError))
            {
                <div class="alert alert-modern alert-danger">@pwError</div>
            }

            <form @onsubmit="ChangePassword">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Current Password <span class="req">*</span></label>
                        <div class="field-icon-wrap pw-wrap">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                            <input type="password" id="currentPassword" class="form-control form-control-modern" placeholder="••••••••" @bind="currentPassword" required />
                            <button type="button" class="pw-toggle" title="Show / Hide" @onclick="ToggleCurrentPassword">
                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                            </button>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">New Password <span class="req">*</span><span class="field-hint">min. 6 characters</span></label>
                        <div class="field-icon-wrap pw-wrap">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                            <input type="password" id="newPassword" class="form-control form-control-modern" placeholder="••••••••" @bind="newPassword" required />
                            <button type="button" class="pw-toggle" title="Show / Hide" @onclick="ToggleNewPassword">
                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                            </button>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Confirm New Password <span class="req">*</span></label>
                        <div class="field-icon-wrap pw-wrap">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                            <input type="password" id="confirmPassword" class="form-control form-control-modern" placeholder="••••••••" @bind="confirmPassword" required />
                            <button type="button" class="pw-toggle" title="Show / Hide" @onclick="ToggleConfirmPassword">
                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                            </button>
                        </div>
                    </div>
                </div>
                <div class="watermark-actions mt-3">
                    <button type="submit" class="btn btn-primary" disabled="@pwBusy">
                        @if (pwBusy)
                        {
                            <span class="loading-spinner me-1"></span>
                        }
                        @(pwBusy ? "Changing..." : "Change Password")
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@code {
    private bool watermarkEnabled = true;
    private string? message;
    private string? error;

    private string watermarkText = "";
    private string originalWatermarkText = "";
    private bool savingText;
    private string? textMessage;
    private string? textError;

    // Change Password
    private string currentPassword = "";
    private string newPassword = "";
    private string confirmPassword = "";
    private string? pwMessage;
    private string? pwError;
    private bool pwBusy;
    private bool showCurrent = false;
    private bool showNew = false;
    private bool showConfirm = false;

    protected override async Task OnInitializedAsync()
    {
        watermarkEnabled = await SettingsService.IsWatermarkEnabledAsync();
        watermarkText = await SettingsService.GetWatermarkTextAsync();
        originalWatermarkText = watermarkText;
    }

    private async Task OnWatermarkChanged(ChangeEventArgs e)
    {
        var enabled = e.Value is bool b ? b : bool.TryParse(e.Value?.ToString(), out var parsed) && parsed;
        message = null;
        error = null;
        try
        {
            await SettingsService.SetWatermarkEnabledAsync(enabled);
            watermarkEnabled = enabled;
            message = enabled ? "Watermark enabled." : "Watermark disabled.";
        }
        catch (Exception ex)
        {
            error = "Failed to save: " + ex.Message;
        }
    }

    private async Task SaveWatermarkText()
    {
        savingText = true;
        textMessage = null;
        textError = null;
        try
        {
            await SettingsService.SetWatermarkTextAsync(watermarkText);
            originalWatermarkText = watermarkText;
            textMessage = "Watermark text saved.";
        }
        catch (Exception ex)
        {
            textError = "Failed to save: " + ex.Message;
        }
        finally
        {
            savingText = false;
        }
    }

    private async Task RestoreDefaultWatermark()
    {
        watermarkText = "LICENSED TO: {shopName}\nUSER: {userName}\nDATE: {date}\nDO NOT DISTRIBUTE";
        await SaveWatermarkText();
    }

    private string[] GetPreviewLines()
    {
        var preview = watermarkText
            .Replace("{shopName}", "Sample Shop")
            .Replace("{userName}", "user@example.com")
            .Replace("{date}", DateTime.Now.ToEgyptLocal().ToString("yyyy-MM-dd HH:mm"))
            .Replace("{timestamp}", DateTime.Now.ToEgyptLocal().ToString("yyyy-MM-dd HH:mm:ss"));
        return preview.Split('\n');
    }

    private void ToggleCurrentPassword()
    {
        showCurrent = !showCurrent;
        try { _ = JS.InvokeVoidAsync(showCurrent ? "revealPassword" : "concealPassword", "currentPassword"); } catch { }
    }

    private void ToggleNewPassword()
    {
        showNew = !showNew;
        try { _ = JS.InvokeVoidAsync(showNew ? "revealPassword" : "concealPassword", "newPassword"); } catch { }
    }

    private void ToggleConfirmPassword()
    {
        showConfirm = !showConfirm;
        try { _ = JS.InvokeVoidAsync(showConfirm ? "revealPassword" : "concealPassword", "confirmPassword"); } catch { }
    }

    private async Task ChangePassword()
    {
        pwMessage = null;
        pwError = null;

        if (string.IsNullOrWhiteSpace(currentPassword))
        {
            pwError = "Current password is required.";
            return;
        }
        if (string.IsNullOrWhiteSpace(newPassword))
        {
            pwError = "New password is required.";
            return;
        }
        if (newPassword.Length < 6)
        {
            pwError = "New password must be at least 6 characters.";
            return;
        }
        if (newPassword != confirmPassword)
        {
            pwError = "New passwords do not match.";
            return;
        }

        pwBusy = true;
        try
        {
            // In an interactive Blazor circuit there is no HttpContext — use AuthStateProvider.
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = await UserManager.GetUserAsync(authState.User);
            if (user == null)
            {
                pwError = "Session expired. Please sign in again.";
                return;
            }

            var result = await UserManager.ChangePasswordAsync(user, currentPassword, newPassword);
            if (result.Succeeded)
            {
                currentPassword = newPassword = confirmPassword = "";
                pwMessage = "Password changed successfully. Signing you out…";
                StateHasChanged();

                // Small delay so the user sees the success message, then redirect
                // to the dedicated signout endpoint (avoids "Headers read-only" on circuits).
                await Task.Delay(1500);
                var destination = Uri.EscapeDataString("/login?message=" + Uri.EscapeDataString("Password changed. Please sign in again."));
                Navigation.NavigateTo($"/api/signout?returnUrl={destination}", forceLoad: true);
            }
            else
            {
                pwError = string.Join("; ", result.Errors.Select(e => e.Description));
            }
        }
        catch (Exception ex)
        {
            pwError = "Failed to change password: " + ex.GetBaseException().Message;
        }
        finally
        {
            pwBusy = false;
        }
    }
}
