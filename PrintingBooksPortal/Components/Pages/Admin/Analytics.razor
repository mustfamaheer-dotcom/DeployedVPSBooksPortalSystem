@page "/admin/analytics"
@attribute [Authorize(Roles = "Teacher,SystemAdmin")]
@rendermode InteractiveServer
@inject AppDbContext Db
@inject PrintLoggingService PrintLogging
@inject NavigationManager Navigation
@inject ITenantContext TenantContext
@inject AuthenticationStateProvider AuthState

<div class="content-area">
    @if (selectedBook != null)
    {
        <div class="d-flex align-items-center justify-content-between mb-3">
            <button class="btn btn-outline-secondary btn-sm" @onclick="CloseBook">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="me-1" style="vertical-align:-2px"><polyline points="15 18 9 12 15 6"/></svg>
                Back to Analytics
            </button>
            <h5 class="mb-0">@selectedBook.Title</h5>
        </div>
        <div class="content-card mb-4">
            <div class="card-header"><h5>Book Details</h5></div>
            <div class="card-body">
                <div class="detail-grid">
                    <div class="detail-item"><span class="detail-label">Board</span><span class="detail-value">@(selectedBook.Board?.Name ?? "—")</span></div>
                    <div class="detail-item"><span class="detail-label">Pages</span><span class="detail-value"><strong>@selectedBook.PageCount</strong></span></div>
                    <div class="detail-item"><span class="detail-label">Created</span><span class="detail-value">@selectedBook.CreatedAt.ToEgyptLocal().ToString("d")</span></div>
                    <div class="detail-item"><span class="detail-label">Status</span><span class="detail-value">@(selectedBook.IsActive ? "Active" : "Inactive")</span></div>
                    <div class="detail-item"><span class="detail-label">Total Prints</span><span class="detail-value"><strong>@totalBookPrints</strong></span></div>
                    <div class="detail-item"><span class="detail-label">Printing Shops</span><span class="detail-value"><strong>@(bookShopPrints?.Count ?? 0)</strong></span></div>
                </div>
            </div>
        </div>
        <div class="row g-4">
            <div class="col-lg-7">
                <div class="content-card">
                    <div class="card-header"><h5>Shops Printing This Book</h5></div>
                    <div class="card-body p-0">
                        @if (bookShopPrints == null || !bookShopPrints.Any())
                        {
                            <div class="empty-state">
                                <div class="empty-icon">
                                    <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="var(--gray-300)" stroke-width="1.5"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
                                </div>
                                <p>No shop has printed this book yet</p>
                            </div>
                        }
                        else
                        {
                            <div class="table-container">
                                <table class="table table-modern">
                                    <thead>
                                        <tr>
                                            <th>Shop</th>
                                            <th class="text-end">Copies Printed</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var item in bookShopPrints.OrderByDescending(x => x.Value))
                                        {
                                            <tr>
                                                <td><span class="shop-tag">@item.Key</span></td>
                                                <td class="text-end"><span class="count-badge count-badge-primary">@item.Value</span></td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                </div>
            </div>
            <div class="col-lg-5">
                <div class="content-card">
                    <div class="card-header"><h5>Recent Prints</h5></div>
                    <div class="card-body p-0">
                        @if (bookLogs == null || !bookLogs.Any())
                        {
                            <div class="empty-state">
                                <div class="empty-icon">
                                    <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="var(--gray-300)" stroke-width="1.5" stroke-linecap="round"><path d="M6 9V2h12v7M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><path d="M6 14h12v8H6z"/></svg>
                                </div>
                                <p>No print activity for this book yet</p>
                            </div>
                        }
                        else
                        {
                            <div class="activity-timeline">
                                @foreach (var log in bookLogs)
                                {
                                    <div class="timeline-item">
                                        <div class="timeline-dot"></div>
                                        <div class="timeline-content">
                                            <div class="timeline-header">
                                                <span class="timeline-shop">@log.ShopName</span>
                                                <span class="timeline-time">@log.PrintedAt.ToEgyptLocal().ToString("g")</span>
                                            </div>
                                            <div class="timeline-body">
                                                <span class="timeline-book">@log.BookTitle</span>
                                                <span class="timeline-badge">
                                                    <strong>@log.Copies</strong> cop@(log.Copies == 1 ? "y" : "ies")
                                                </span>
                                            </div>
                                            <div class="timeline-footer">
                                                <span class="timeline-user">by @log.PrintedByUserName</span>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
    else if (selectedShop != null)
    {
        <div class="d-flex align-items-center justify-content-between mb-3">
            <button class="btn btn-outline-secondary btn-sm" @onclick="CloseShop">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="me-1" style="vertical-align:-2px"><polyline points="15 18 9 12 15 6"/></svg>
                Back to Analytics
            </button>
            <h5 class="mb-0">@selectedShop.Name</h5>
        </div>
        <div class="content-card mb-4">
            <div class="card-header"><h5>Shop Details</h5></div>
            <div class="card-body">
                <div class="detail-grid">
                    <div class="detail-item"><span class="detail-label">Address</span><span class="detail-value">@(selectedShop.Address ?? "—")</span></div>
                    <div class="detail-item"><span class="detail-label">Phone</span><span class="detail-value">@(selectedShop.Phone ?? "—")</span></div>
                    <div class="detail-item"><span class="detail-label">Created</span><span class="detail-value">@selectedShop.CreatedAt.ToEgyptLocal().ToString("d")</span></div>
                    <div class="detail-item"><span class="detail-label">Status</span><span class="detail-value">@(selectedShop.IsActive ? "Active" : "Inactive")</span></div>
                    <div class="detail-item"><span class="detail-label">Total Prints</span><span class="detail-value"><strong>@totalShopPrints</strong></span></div>
                    <div class="detail-item"><span class="detail-label">Assigned Books</span><span class="detail-value"><strong>@(shopBooks?.Count ?? 0)</strong></span></div>
                </div>
            </div>
        </div>
        <div class="row g-4">
            <div class="col-lg-7">
                <div class="content-card">
                    <div class="card-header"><h5>Assigned Books</h5></div>
                    <div class="card-body p-0">
                        @if (shopBooks == null || !shopBooks.Any())
                        {
                            <div class="empty-state">
                                <div class="empty-icon">
                                    <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="var(--gray-300)" stroke-width="1.5"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
                                </div>
                                <p>No books assigned to this shop</p>
                            </div>
                        }
                        else
                        {
                            <div class="table-container">
                                <table class="table table-modern">
                                    <thead>
                                        <tr>
                                            <th>Title</th>
                                            <th>Board</th>
                                            <th>Pages</th>
                                            <th class="text-end">Copies Printed</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var assignment in shopBooks)
                                        {
                                            <tr>
                                                <td><strong>@assignment.Book.Title</strong></td>
                                                <td><span class="board-tag">@assignment.Book.Board?.Name</span></td>
                                                <td><span class="count-badge">@assignment.Book.PageCount</span></td>
                                                <td class="text-end">
                                                    <span class="count-badge count-badge-primary">@(bookPrintCounts.TryGetValue(assignment.BookId, out var cnt) ? cnt : 0)</span>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                </div>
            </div>
            <div class="col-lg-5">
                <div class="content-card">
                    <div class="card-header"><h5>Recent Prints</h5></div>
                    <div class="card-body p-0">
                        @if (shopLogs == null || !shopLogs.Any())
                        {
                            <div class="empty-state">
                                <div class="empty-icon">
                                    <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="var(--gray-300)" stroke-width="1.5" stroke-linecap="round"><path d="M6 9V2h12v7M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><path d="M6 14h12v8H6z"/></svg>
                                </div>
                                <p>No print activity for this shop yet</p>
                            </div>
                        }
                        else
                        {
                            <div class="activity-timeline">
                                @foreach (var log in shopLogs)
                                {
                                    <div class="timeline-item">
                                        <div class="timeline-dot"></div>
                                        <div class="timeline-content">
                                            <div class="timeline-header">
                                                <span class="timeline-book">@log.BookTitle</span>
                                                <span class="timeline-time">@log.PrintedAt.ToEgyptLocal().ToString("g")</span>
                                            </div>
                                            <div class="timeline-body">
                                                <span class="timeline-badge">
                                                    <strong>@log.Copies</strong> cop@(log.Copies == 1 ? "y" : "ies")
                                                </span>
                                            </div>
                                            <div class="timeline-footer">
                                                <span class="timeline-user">by @log.PrintedByUserName</span>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
    <div class="page-header">
        <div>
            <h1>Analytics Dashboard</h1>
            <p class="page-subtitle">Detailed insights into printing activity across all shops</p>
        </div>
        <div class="page-header-actions">
            <div class="period-selector">
                <button class="period-btn @(period == 7 ? "active" : "")" @onclick="() => { period = 7; _ = LoadDataAsync(); }">7 Days</button>
                <button class="period-btn @(period == 30 ? "active" : "")" @onclick="() => { period = 30; _ = LoadDataAsync(); }">30 Days</button>
                <button class="period-btn @(period == 0 ? "active" : "")" @onclick="() => { period = 0; _ = LoadDataAsync(); }">All Time</button>
            </div>
        </div>
    </div>

    <div class="analytics-grid">
        <div class="stat-card stat-card-primary">
            <div class="stat-icon">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>
            </div>
            <div class="stat-body">
                <div class="stat-label">Total Prints</div>
                <div class="stat-value">@totalPrints</div>
            </div>
        </div>
        <div class="stat-card stat-card-success">
            <div class="stat-icon">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
            </div>
            <div class="stat-body">
                <div class="stat-label">Active Shops</div>
                <div class="stat-value">@activeShops</div>
            </div>
        </div>
        <div class="stat-card stat-card-purple">
            <div class="stat-icon">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
            </div>
            <div class="stat-body">
                <div class="stat-label">Total Books</div>
                <div class="stat-value">@totalBooks</div>
            </div>
        </div>
        <div class="stat-card stat-card-rose">
            <div class="stat-icon">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
            </div>
            <div class="stat-body">
                <div class="stat-label">Total Logs</div>
                <div class="stat-value">@totalLogs</div>
            </div>
        </div>
    </div>
    
    @if (studentReadingStats != null && studentReadingStats.Any())
    {
        <div class="analytics-card full-width mb-4">
            <div class="card-header">
                <h5>Student Reading Analytics</h5>
                <span class="count-badge">@(studentReadingStats.Count) Books Tracked</span>
            </div>
            <div class="card-body p-0">
                <div class="table-container">
                    <table class="table table-modern">
                        <thead>
                            <tr>
                                <th>Book Title</th>
                                <th>Students Reading</th>
                                <th>Avg. Progress</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var stat in studentReadingStats.OrderByDescending(s => s.StudentsCount))
                            {
                                <tr>
                                    <td><strong>@stat.BookTitle</strong></td>
                                    <td><span class="count-badge">@stat.StudentsCount</span></td>
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="progress flex-grow-1" style="height: 6px; width: 100px;">
                                                <div class="progress-bar bg-primary" style="width: @(stat.AvgProgress)%;"></div>
                                            </div>
                                            <span class="small fw-semibold">@(stat.AvgProgress)%</span>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }

    <div class="analytics-row">
        <div class="analytics-card">
            <div class="card-header">
                <h5>Prints per Shop</h5>
                <span class="count-badge">@(printsPerShop?.Count ?? 0)</span>
            </div>
            <div class="card-body p-0">
                @if (printsPerShop != null && printsPerShop.Any())
                {
                    <div class="chart-list">
                        @foreach (var item in printsPerShop)
                        {
                            <button class="chart-row chart-row-btn" @onclick="() => OpenShop(item.ShopId)">
                                <span class="chart-label">@item.ShopName</span>
                                <div class="chart-bar-track">
                                    <div class="chart-bar chart-bar-primary" style="width: @(Math.Min(item.Total * 100 / printsPerShop.Max(x => x.Total), 100))%;"></div>
                                </div>
                                <span class="chart-value">@item.Total</span>
                                <svg class="chart-chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
                            </button>
                        }
                    </div>
                }
                else
                {
                    <div class="empty-state"><p>No print data yet.</p></div>
                }
            </div>
        </div>
        <div class="analytics-card">
            <div class="card-header">
                <h5>Prints per Book</h5>
                <span class="count-badge">@(printsPerBook?.Count ?? 0)</span>
            </div>
            <div class="card-body p-0">
                @if (printsPerBook != null && printsPerBook.Any())
                {
                    <div class="chart-list">
                        @foreach (var item in printsPerBook)
                        {
                            <button class="chart-row chart-row-btn" @onclick="() => OpenBook(item.BookId)">
                                <span class="chart-label">@item.BookTitle</span>
                                <div class="chart-bar-track">
                                    <div class="chart-bar chart-bar-purple" style="width: @(Math.Min(item.Total * 100 / printsPerBook.Max(x => x.Total), 100))%;"></div>
                                </div>
                                <span class="chart-value">@item.Total</span>
                                <svg class="chart-chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
                            </button>
                        }
                    </div>
                }
                else
                {
                    <div class="empty-state"><p>No print data yet.</p></div>
                }
            </div>
        </div>
    </div>

    <div class="analytics-card full-width">
        <div class="card-header">
            <h5>Daily Trends</h5>
            @if (dailyTrends != null && dailyTrends.Any())
            {
                <div class="trend-summary">
                    <span class="trend-total">@dailyTrends.Sum(d => d.PrintCount) prints</span>
                    <span class="trend-sep">|</span>
                    <span class="trend-total">@dailyTrends.Sum(d => d.TotalCopies) copies</span>
                </div>
            }
        </div>
        <div class="card-body p-0">
            @if (dailyTrends == null)
            {
                <div class="loading-placeholder">Loading...</div>
            }
            else if (!dailyTrends.Any())
            {
                <div class="empty-state"><p>No data for selected period.</p></div>
            }
            else
            {
                var maxCopies = dailyTrends.Max(d => d.TotalCopies);
                <div class="bar-chart-container">
                    @foreach (var item in dailyTrends)
                    {
                        var barH = maxCopies > 0 ? item.TotalCopies * 100 / maxCopies : 0;
                        <div class="bar-chart-column">
                            <div class="bar-chart-value">@item.PrintCount</div>
                            <div class="bar-chart-bar-wrap">
                                <div class="bar-chart-bar" style="height: @(barH)%;">
                                    <div class="bar-chart-bar-inner"></div>
                                </div>
                            </div>
                            <div class="bar-chart-label">@item.Date.ToEgyptLocal().ToString("MMM dd")</div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>

    <div class="analytics-card full-width">
        <div class="card-header">
            <h5>Recent Print Logs</h5>
            <span class="count-badge">@(recentLogs?.Count ?? 0) entries</span>
        </div>
        <div class="card-body p-0">
            @if (recentLogs == null)
            {
                <div class="loading-placeholder">Loading...</div>
            }
            else if (!recentLogs.Any())
            {
                <div class="empty-state"><p>No logs yet.</p></div>
            }
            else
            {
                <div class="table-container" style="max-height: 380px; overflow-y: auto;">
                    <table class="table table-modern">
                        <thead>
                            <tr>
                                <th>Date/Time</th>
                                <th>Shop</th>
                                <th>Book</th>
                                <th>Pages</th>
                                <th>Copies</th>
                                <th>User</th>
                                <th>IP</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var log in recentLogs)
                            {
                                <tr>
                                    <td class="text-muted">@log.PrintedAt.ToEgyptLocal().ToString("g")</td>
                                    <td><span class="shop-tag">@log.ShopName</span></td>
                                    <td>@log.BookTitle</td>
                                    <td><span class="pages-badge">@PdfPageSelection.DescribePages(log.Pages, log.Book?.PageCount)</span></td>
                                    <td><strong>@log.Copies</strong></td>
                                    <td>@log.PrintedByUserName</td>
                                    <td><code class="ip-badge">@log.IPAddress</code></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
    }
</div>

@code {
    private int period = 7;
    private int totalPrints;
    private int activeShops;
    private int totalBooks;
    private int totalLogs;
    private List<PrintLoggingService.ShopPrintStat>? printsPerShop;
    private List<PrintLoggingService.BookPrintStat>? printsPerBook;
    private List<PrintLog>? recentLogs;
    private List<DailyTrend>? dailyTrends;
    private List<ReadingStat>? studentReadingStats;

    private Shop? selectedShop;
    private List<ShopBookAssignment>? shopBooks;
    private Dictionary<int, int> bookPrintCounts = new();
    private List<PrintLog>? shopLogs;
    private int totalShopPrints;

    private Book? selectedBook;
    private Dictionary<string, int>? bookShopPrints;
    private List<PrintLog>? bookLogs;
    private int totalBookPrints;

    private class DailyTrend
    {
        public DateTime Date { get; set; }
        public int PrintCount { get; set; }
        public int TotalCopies { get; set; }
    }
    
    private class ReadingStat
    {
        public string BookTitle { get; set; } = "";
        public int StudentsCount { get; set; }
        public int AvgProgress { get; set; }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        totalPrints = await PrintLogging.GetTotalPrintsAsync();
        activeShops = await Db.Shops.CountAsync(s => s.IsActive);
        totalBooks = await Db.Books.CountAsync(b => b.IsActive);
        totalLogs = await Db.PrintLogs.CountAsync();
        printsPerShop = await PrintLogging.GetShopPrintStatsAsync();
        printsPerBook = await PrintLogging.GetPrintsPerBookAsync();
        recentLogs = await PrintLogging.GetRecentLogsAsync(100);

        var now = DateTime.UtcNow;
        DateTime? cutoff = period > 0 ? now.AddDays(-period) : null;
        var query = Db.PrintLogs.AsNoTracking();
        if (cutoff.HasValue)
            query = query.Where(l => l.PrintedAt >= cutoff.Value);

        dailyTrends = await query
            .GroupBy(l => l.PrintedAt.Date)
            .Select(g => new DailyTrend
            {
                Date = g.Key,
                PrintCount = g.Count(),
                TotalCopies = g.Sum(l => l.Copies)
            })
            .OrderBy(x => x.Date)
            .ToListAsync();
            
        // Load reading stats if Teacher
        var state = await AuthState.GetAuthenticationStateAsync();
        if (state.User.IsInRole("Teacher") && TenantContext.TenantId > 0)
        {
            var progresses = await Db.StudentReadingProgresses
                .Include(p => p.Book)
                .Where(p => p.TenantId == TenantContext.TenantId)
                .ToListAsync();
                
            studentReadingStats = progresses
                .GroupBy(p => p.Book.Title)
                .Select(g => new ReadingStat
                {
                    BookTitle = g.Key,
                    StudentsCount = g.Count(),
                    AvgProgress = (int)g.Average(p => p.TotalPages > 0 ? (double)p.LastPageRead / p.TotalPages * 100 : 0)
                })
                .ToList();
        }
    }

    private async Task OpenShop(int shopId)
    {
        var shop = await Db.Shops.FindAsync(shopId);
        if (shop == null) return;
        selectedShop = shop;
        shopBooks = await Db.ShopBookAssignments
            .Where(a => a.ShopId == shop.Id && a.IsActive)
            .Include(a => a.Book)
            .ThenInclude(b => b.Board)
            .OrderBy(a => a.Book.Title)
            .ToListAsync();
        var counts = await Db.PrintLogs.Where(l => l.ShopId == shop.Id)
            .GroupBy(l => l.BookId)
            .Select(g => new { BookId = g.Key, Total = g.Sum(l => l.Copies) })
            .ToListAsync();
        bookPrintCounts = counts.ToDictionary(c => c.BookId, c => c.Total);
        totalShopPrints = await Db.PrintLogs.Where(l => l.ShopId == shop.Id).SumAsync(l => l.Copies);
        shopLogs = await PrintLogging.GetShopLogsAsync(shop.Id, 20);
    }

    private void CloseShop()
    {
        selectedShop = null;
        shopBooks = null;
        shopLogs = null;
    }

    private async Task OpenBook(int bookId)
    {
        selectedBook = await Db.Books
            .Include(b => b.Board)
            .AsNoTracking()
            .FirstOrDefaultAsync(b => b.Id == bookId);
        if (selectedBook == null) return;

        var stats = await Db.PrintLogs.Where(l => l.BookId == selectedBook.Id)
            .GroupBy(l => l.ShopName)
            .Select(g => new { Shop = g.Key, Total = g.Sum(l => l.Copies) })
            .ToListAsync();
        bookShopPrints = stats.ToDictionary(x => x.Shop, x => x.Total);
        totalBookPrints = stats.Sum(x => x.Total);
        bookLogs = await PrintLogging.GetBookLogsAsync(selectedBook.Id, 20);
    }

    private void CloseBook()
    {
        selectedBook = null;
        bookShopPrints = null;
        bookLogs = null;
    }
}
