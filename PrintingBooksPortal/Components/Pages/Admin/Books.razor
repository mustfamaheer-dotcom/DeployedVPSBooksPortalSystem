@page "/admin/books"
@attribute [Authorize(Roles = "Teacher,SystemAdmin")]
@rendermode InteractiveServer
@using System.Text.Json
@inject AppDbContext Db
@inject FileStorageService FileStorage
@inject NavigationManager Navigation
@inject IJSRuntime JS

<div class="content-area">
    <div class="page-header">
        <div>
            <h1>Books</h1>
            <p class="page-subtitle">Manage educational books and upload PDFs</p>
        </div>
        <div class="page-header-actions">
            <button class="btn btn-primary" @onclick="() => showUpload = !showUpload">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
                Upload Book
            </button>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(message))
    {
        <div class="alert alert-modern alert-success">@message</div>
    }
    @if (!string.IsNullOrEmpty(error))
    {
        <div class="alert alert-modern alert-danger">@error</div>
    }

    @if (uploadActive && (uploadKind == "edit" ? !showEditModal : !showUpload))
    {
        <div class="upload-card mb-4">
            <div class="upload-card-header">
                <div class="d-flex align-items-center gap-2">
                    <span class="loading-spinner me-1"></span>
                    <h5 class="mb-0">Uploading '@uploadTitle'…</h5>
                </div>
            </div>
            <div class="upload-card-body">
                <div class="upload-progress">
                    <div class="upload-progress-bar">
                        <div class="upload-progress-fill" style="width:@(uploadProgress)%"></div>
                    </div>
                    <span class="upload-progress-text">@uploadProgress%</span>
                </div>
            </div>
        </div>
    }

    @if (showUpload)
    {
        <div class="upload-card mb-4">
            <div class="upload-card-header">
                <div class="d-flex align-items-center gap-2">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
                    <h5 class="mb-0">Upload New Book</h5>
                </div>
                <button type="button" class="modal-close" @onclick="() => showUpload = false">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                </button>
            </div>
            <div class="upload-card-body">
                <form @onsubmit="StartUpload" @onsubmit:preventDefault="true">
                    <div class="row g-3">
                        <div class="col-md-7">
                            <label class="form-label">Book Title</label>
                            <InputText id="uploadTitle" @bind-Value="uploadModel.Title" class="form-control form-control-modern" placeholder="Enter book title" required />
                        </div>
                        <div class="col-md-5">
                            <label class="form-label">Educational Board</label>
                            <select id="uploadBoard" class="form-select form-control-modern" @bind="uploadModel.BoardId">
                                <option value="0">-- Select Board --</option>
                                @foreach (var board in boards)
                                {
                                    <option value="@board.Id">@board.Name</option>
                                }
                            </select>
                        </div>
                    </div>
                    <div class="mb-3 mt-3">
                        <label class="form-label">PDF File</label>
                        <div class="file-drop-zone" id="pdfDropZone">
                            <input type="file" id="pdfUpload" accept=".pdf" class="file-input-hidden" />
                            <label for="pdfUpload" class="file-drop-label">
                                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--gray-400)" stroke-width="1.5"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="12" y1="18" x2="12" y2="12"/><line x1="9" y1="15" x2="15" y2="15"/></svg>
                                <span id="uploadFileName">Click to select a PDF file or drag & drop</span>
                            </label>
                        </div>
                        <div class="form-hint" id="uploadPagesHint">The page count is detected automatically from the PDF.</div>
                    </div>
                    <div class="upload-progress" id="uploadProgressWrap" style="display:none;">
                        <div class="upload-progress-bar">
                            <div class="upload-progress-fill" id="uploadProgressBar" style="width:0%"></div>
                        </div>
                        <span class="upload-progress-text" id="uploadProgressText">0%</span>
                    </div>
                    <button type="submit" class="btn btn-primary" disabled="@loading">
                        @if (loading)
                        {
                            <span class="loading-spinner me-1"></span>
                        }
                        @(loading ? "Uploading..." : "Upload Book")
                    </button>
                </form>
            </div>
        </div>
    }

    @* Delete Confirmation Modal *@
    <div class="modal-overlay @(showDeleteModal ? "show" : "")" @onclick="() => showDeleteModal = false">
        <div class="modal-container modal-sm" @onclick:stopPropagation>
            <div class="modal-body text-center py-4">
                <div class="delete-icon mb-3">
                    <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="var(--danger)" stroke-width="1.5"><path d="M3 6h18"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
                </div>
                <h5 class="mb-2">Delete Book</h5>
                <p class="text-muted mb-3">Are you sure you want to delete <strong>@deletingBook?.Title</strong>?</p>
                <div class="modal-actions justify-content-center">
                    <button class="btn btn-outline-secondary" @onclick="() => showDeleteModal = false">Cancel</button>
                    <button class="btn btn-danger" @onclick="ConfirmDelete">Delete</button>
                </div>
            </div>
        </div>
    </div>

    @* Edit Book Modal *@
    <div class="modal-overlay @(showEditModal ? "show" : "")" @onclick="() => showEditModal = false">
        <div class="modal-container" @onclick:stopPropagation>
            <div class="modal-header">
                <h5 class="modal-title">Edit Book</h5>
                <button type="button" class="modal-close" @onclick="() => showEditModal = false">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                </button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label">Book Title</label>
                    <InputText id="editTitle" @bind-Value="editModel.Title" class="form-control form-control-modern" placeholder="Enter book title" required />
                </div>
                <div class="row g-3 mb-3">
                    <div class="col-md-8">
                        <label class="form-label">Educational Board</label>
                        <select id="editBoard" class="form-select form-control-modern" @bind="editModel.BoardId">
                            <option value="0">-- Select Board --</option>
                            @foreach (var board in boards)
                            {
                                <option value="@board.Id">@board.Name</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Active</label>
                        <div class="form-check mt-2">
                            <input id="editIsActive" type="checkbox" class="form-check-input" @bind="editModel.IsActive" />
                            <label class="form-check-label" for="editIsActive">Book is active</label>
                        </div>
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label">Replace PDF (optional)</label>
                    <div class="file-drop-zone" id="editPdfDropZone">
                        <input type="file" id="editPdfUpload" accept=".pdf" class="file-input-hidden" />
                        <label for="editPdfUpload" class="file-drop-label">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--gray-400)" stroke-width="1.5"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="12" y1="18" x2="12" y2="12"/><line x1="9" y1="15" x2="15" y2="15"/></svg>
                            <span id="editFileName">Click to select a new PDF file (optional)</span>
                        </label>
                    </div>
                    <div class="form-hint" id="editPagesHint">When replacing the PDF, the page count is detected automatically.</div>
                </div>
                <div class="upload-progress" id="editProgressWrap" style="display:none;">
                    <div class="upload-progress-bar">
                        <div class="upload-progress-fill" id="editProgressBar" style="width:0%"></div>
                    </div>
                    <span class="upload-progress-text" id="editProgressText">0%</span>
                </div>
                <div class="modal-actions">
                    <button class="btn btn-outline-secondary" @onclick="() => showEditModal = false">Cancel</button>
                    <button class="btn btn-primary" @onclick="SaveEditBook" disabled="@loading">
                        @if (loading)
                        {
                            <span class="loading-spinner me-1"></span>
                        }
                        @(loading ? "Saving..." : "Save Changes")
                    </button>
                </div>
            </div>
        </div>
    </div>

    <div class="content-card">
        <div class="card-body p-0">
            @if (books == null)
            {
                <div class="loading-placeholder">Loading...</div>
            }
            else if (!books.Any())
            {
                <div class="empty-state">
                    <div class="empty-icon">
                        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="var(--gray-300)" stroke-width="1.5"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
                    </div>
                    <p>No books uploaded yet</p>
                </div>
            }
            else
            {
                <div class="table-container">
                    <table class="table table-modern">
                        <thead>
                            <tr>
                                <th>Title</th>
                                <th>Board</th>
                                <th>Size</th>
                                <th>Pages</th>
                                <th>Status</th>
                                <th>Uploaded</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var book in books)
                            {
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="book-icon">
                                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--primary)" stroke-width="2"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
                                            </div>
                                            <strong>@book.Title</strong>
                                        </div>
                                    </td>
                                    <td><span class="board-tag">@book.Board?.Name</span></td>
                                    <td>@FormatSize(book.FileSizeBytes)</td>
                                    <td><span class="count-badge">@book.PageCount</span></td>
                                    <td>
                                        <span class="status-badge @(book.IsActive ? "status-active" : "status-inactive")">
                                            <span class="status-dot"></span>
                                            @(book.IsActive ? "Active" : "Inactive")
                                        </span>
                                    </td>
                                    <td class="text-muted">@book.CreatedAt.ToEgyptLocal().ToString("d")</td>
                                    <td class="text-end">
                                        <div class="action-btns">
                                            <button class="btn-icon btn-icon-edit" title="Edit" @onclick="() => OpenEdit(book)">
                                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                                            </button>
                                            <button class="btn-icon btn-icon-danger" title="Delete" @onclick="() => { deletingBook = book; showDeleteModal = true; }">
                                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

@code {
    private List<Book>? books;
    private List<EducationalBoard> boards = new();
    private BookUploadModel uploadModel = new();
    private EditBookModel editModel = new();
    private bool loading;
    private bool showUpload;
    private bool showDeleteModal;
    private bool showEditModal;
    private Book? deletingBook;
    private Book? editingBook;
    private bool pendingEdit;
    private int uploadProgress;
    private bool uploadActive;
    private string? uploadTitle;
    private string uploadKind = "upload";
    private string? message;
    private string? error;
    private IJSObjectReference? booksModule;
    private DotNetObjectReference<Books>? dotNetRef;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // On first render, always wire the module and restore any upload that is
        // still running (or already finished) from a previous visit to this page.
        if (firstRender)
        {
            await EnsureModule();
            await RestoreUploadState();
        }
        // Wire drag-and-drop onto the drop zones once their UI is visible.
        else if (showUpload || showEditModal)
        {
            if (booksModule == null)
            {
                await EnsureModule();
            }
            else
            {
                await booksModule.InvokeVoidAsync("refresh");
            }
        }
    }

    private async Task EnsureModule()
    {
        if (booksModule == null)
        {
            booksModule = await JS.InvokeAsync<IJSObjectReference>("import",
                "./Components/Pages/Admin/Books.razor.js");
            dotNetRef ??= DotNetObjectReference.Create(this);
            await booksModule.InvokeVoidAsync("init", dotNetRef);
        }
    }

    private async Task LoadData()
    {
        // Clear tracked entities so the list always reflects the latest DB state
        // (the edit/upload API writes through its own request-scoped context).
        Db.ChangeTracker.Clear();
        boards = await Db.EducationalBoards.Where(b => b.IsActive).ToListAsync<EducationalBoard>();
        books = await Db.Books.Include(b => b.Board).OrderByDescending(b => b.CreatedAt).ToListAsync<Book>();
    }

    private void OpenEdit(Book book)
    {
        editingBook = book;
        editModel.Title = book.Title;
        editModel.BoardId = book.BoardId;
        editModel.PageCount = book.PageCount;
        editModel.IsActive = book.IsActive;
        error = null;
        showEditModal = true;
    }

    private async Task StartUpload()
    {
        error = null;
        if (string.IsNullOrWhiteSpace(uploadModel.Title))
        {
            error = "Please enter a book title.";
            return;
        }
        if (uploadModel.BoardId == 0)
        {
            error = "Please select a board.";
            return;
        }

        loading = true;
        uploadProgress = 0;
        pendingEdit = false;
        uploadKind = "upload";
        uploadActive = true;
        uploadTitle = uploadModel.Title;
        await EnsureModule();
        await booksModule!.InvokeVoidAsync("uploadNewBook");
    }

    private async Task SaveEditBook()
    {
        error = null;
        if (string.IsNullOrWhiteSpace(editModel.Title))
        {
            error = "Book title is required.";
            return;
        }

        loading = true;
        uploadProgress = 0;
        pendingEdit = true;
        uploadKind = "edit";
        uploadActive = true;
        uploadTitle = editModel.Title;
        await EnsureModule();
        await booksModule!.InvokeVoidAsync("updateBook", editingBook!.Id);
    }

    [JSInvokable]
    public void OnUploadProgress(int percent)
    {
        uploadProgress = percent;
        StateHasChanged();
    }

    [JSInvokable]
    public async Task OnUploadComplete(string json)
    {
        UploadResult? result = null;
        try
        {
            result = JsonSerializer.Deserialize<UploadResult>(json,
                new JsonSerializerOptions { PropertyNameCaseInsensitive = true });
        }
        catch
        {
            // Malformed payload — fall through to the generic error below.
        }

        await HandleUploadResult(result);
        StateHasChanged();
    }

    private async Task HandleUploadResult(UploadResult? result)
    {
        loading = false;
        uploadProgress = 0;
        uploadActive = false;
        uploadTitle = null;

        if (result?.Success == true)
        {
            error = null;
            if (pendingEdit)
            {
                showEditModal = false;
                editingBook = null;
                editModel = new();
                pendingEdit = false;
            }
            else
            {
                showUpload = false;
                uploadModel = new();
            }
            message = result.Message;
            await LoadData();
        }
        else
        {
            error = result?.Error ?? "Upload failed.";
        }
    }

    private async Task RestoreUploadState()
    {
        if (booksModule == null) return;

        string json;
        try
        {
            json = await booksModule.InvokeAsync<string>("getState") ?? "";
        }
        catch
        {
            return;
        }
        if (string.IsNullOrEmpty(json)) return;

        UploadStateDto? state = null;
        try
        {
            state = JsonSerializer.Deserialize<UploadStateDto>(json,
                new JsonSerializerOptions { PropertyNameCaseInsensitive = true });
        }
        catch
        {
            return;
        }
        if (state == null) return;

        if (state.Active)
        {
            uploadActive = true;
            loading = true;
            uploadProgress = state.Percent;
            uploadTitle = state.Title;
            uploadKind = string.IsNullOrEmpty(state.Kind) ? "upload" : state.Kind;
        }
        if (state.Result != null)
        {
            await HandleUploadResult(state.Result);
        }
        StateHasChanged();
    }

    private async Task ConfirmDelete()
    {
        if (deletingBook == null) return;
        var book = await Db.Books.FirstOrDefaultAsync(b => b.Id == deletingBook.Id);
        if (book == null)
        {
            showDeleteModal = false;
            deletingBook = null;
            return;
        }
        Db.Books.Remove(book);
        await Db.SaveChangesAsync();
        FileStorage.DeleteFile(deletingBook.FilePath);
        await LoadData();
        message = $"Book '{deletingBook.Title}' deleted.";
        showDeleteModal = false;
        deletingBook = null;
    }

    private static string FormatSize(long bytes)
    {
        return bytes switch
        {
            >= 1_000_000 => $"{bytes / 1_000_000.0:F1} MB",
            >= 1_000 => $"{bytes / 1_000.0:F1} KB",
            _ => $"{bytes} B"
        };
    }

    public void Dispose()
    {
        dotNetRef?.Dispose();
    }

    private class BookUploadModel
    {
        public string Title { get; set; } = "";
        public int BoardId { get; set; }
        public int PageCount { get; set; }
    }

    private class EditBookModel
    {
        public string Title { get; set; } = "";
        public int BoardId { get; set; }
        public int PageCount { get; set; }
        public bool IsActive { get; set; } = true;
    }

    private class UploadResult
    {
        public bool Success { get; set; }
        public string? Message { get; set; }
        public string? Error { get; set; }
    }

    private class UploadStateDto
    {
        public bool Active { get; set; }
        public string Kind { get; set; } = "";
        public int Percent { get; set; }
        public string Title { get; set; } = "";
        public UploadResult? Result { get; set; }
    }
}
